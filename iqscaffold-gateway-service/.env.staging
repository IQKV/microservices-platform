# Staging Environment Variables for Gateway Service
SPRING_PROFILES_ACTIVE=staging

# Redis Configuration
IQSCAFFOLD_CACHE_REDIS_HOST=redis
IQSCAFFOLD_CACHE_REDIS_PORT=6379
IQSCAFFOLD_CACHE_REDIS_PASSWORD=${REDIS_PASSWORD}
IQSCAFFOLD_CACHE_REDIS_DATABASE=1

# Gateway Routing Configuration
IQSCAFFOLD_GATEWAY_ROUTING_USER_SERVICE_URI=http://user-service:8080
IQSCAFFOLD_GATEWAY_ROUTING_BILLING_SERVICE_URI=http://billing-service:8082
IQSCAFFOLD_GATEWAY_ROUTING_CONTACT_SERVICE_URI=http://contact-service:8083
IQSCAFFOLD_GATEWAY_ROUTING_LEAD_SERVICE_URI=http://lead-service:8084
IQSCAFFOLD_GATEWAY_ROUTING_PIPELINE_SERVICE_URI=http://pipeline-service:8085

# Gateway Security Configuration
IQSCAFFOLD_GATEWAY_SECURITY_JWT_SECRET=${JWT_SECRET}
IQSCAFFOLD_GATEWAY_SECURITY_USER_SERVICE_URL=http://user-service:8080

# Gateway CORS Configuration
IQSCAFFOLD_GATEWAY_CORS_ALLOWED_ORIGINS=https://iqscaffold.website

# Observability Configuration
IQSCAFFOLD_OBSERVABILITY_TRACING_ENDPOINT=http://jaeger:14268/api/traces

# Redis Configuration
REDIS_PASSWORD=${REDIS_PASSWORD}
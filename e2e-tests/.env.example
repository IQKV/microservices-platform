# Test Environment Configuration
TEST_ENV=local

# Environment Variable Overrides (optional - will use defaults from environments.ts if not set)
BASE_URL=http://localhost:8090
GATEWAY_URL=http://localhost:8090
USER_SERVICE_URL=http://localhost:8091

# Database Configuration Overrides
DATABASE_USER_URL=postgresql://foundation_test_iam:foundation_test_password@localhost:5434/foundation_iam_test
REDIS_URL=redis://localhost:6380

# Test Execution Configuration
TEST_TIMEOUT=60000
TEST_WORKERS=4
DEBUG=false
HEADLESS=true
SCREENSHOT=only-on-failure
VIDEO=retain-on-failure
TRACE=retain-on-failure

# Staging Environment Credentials (for staging tests)
STAGING_DB_PASSWORD=your_staging_db_password
STAGING_REDIS_PASSWORD=your_staging_redis_password

# Production Environment Credentials (for production tests)
PROD_DB_PASSWORD=your_production_db_password
PROD_REDIS_PASSWORD=your_production_redis_password

# Test Data Configuration
FAKER_SEED=12345
TEST_USER_EMAIL_DOMAIN=test.foundation.site
TEST_TENANT_PREFIX=test-tenant

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# CI/CD Configuration
CI=false
GENERATE_REPORTS=true
UPLOAD_ARTIFACTS=false
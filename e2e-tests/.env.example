# Test Environment Configuration
TEST_ENV=local

# Local Environment URLs
LOCAL_GATEWAY_URL=http://localhost:8080
LOCAL_AUTH_URL=http://localhost:8081
LOCAL_BOOKSTORE_URL=http://localhost:8082

# Staging Environment URLs
STAGING_GATEWAY_URL=https://staging-api.gripday.com
STAGING_AUTH_URL=https://staging-auth.gripday.com
STAGING_BOOKSTORE_URL=https://staging-bookstore.gripday.com

# Production Environment URLs
PRODUCTION_GATEWAY_URL=https://api.gripday.com
PRODUCTION_AUTH_URL=https://auth.gripday.com
PRODUCTION_BOOKSTORE_URL=https://bookstore.gripday.com

# Test Configuration
TEST_TIMEOUT=30000
TEST_RETRIES=1
TEST_WORKERS=4
TEST_HEADLESS=true

# Database Configuration (for local testing)
TEST_AUTH_DB_URL=postgresql://localhost:5432/gripday_auth_test
TEST_BOOKSTORE_DB_URL=postgresql://localhost:5433/gripday_bookstore_test
TEST_REDIS_URL=redis://localhost:6379

# Test Data Configuration
FAKER_SEED=12345
TEST_USER_EMAIL_DOMAIN=test.gripday.com
TEST_TENANT_PREFIX=test-tenant

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# CI/CD Configuration
CI=false
GENERATE_REPORTS=true
UPLOAD_ARTIFACTS=false
{
  "name": "gripday-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end API testing suite for Gripday microservices platform",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "install:browsers": "playwright install",
    "lint": "eslint src/**/*.ts",
    "test": "playwright test",
    "test:debug": "playwright test --debug",
    "test:docker": "docker-compose -f docker-compose.test.yml up --build --abort-on-container-exit",
    "test:docker:down": "docker-compose -f docker-compose.test.yml down -v",
    "test:headed": "playwright test --headed",
    "test:local": "playwright test --config=playwright.config.ts",
    "test:production": "cross-env TEST_ENV=production playwright test",
    "test:report": "playwright show-report",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "test:ui": "playwright test --ui",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^8.3.1",
    "@playwright/test": "^1.40.0",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "pg": "^8.11.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

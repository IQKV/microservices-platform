<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-lead-notes-table" author="iqscaffold">
        <createTable tableName="lead_notes">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="lead_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="is_pinned" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="lead_notes" indexName="idx_lead_notes_lead_id">
            <column name="lead_id"/>
        </createIndex>

        <createIndex tableName="lead_notes" indexName="idx_lead_notes_created_at">
            <column name="created_at"/>
        </createIndex>

        <createIndex tableName="lead_notes" indexName="idx_lead_notes_pinned">
            <column name="is_pinned"/>
        </createIndex>

        <addForeignKeyConstraint
            baseTableName="lead_notes"
            baseColumnNames="lead_id"
            referencedTableName="leads"
            referencedColumnNames="id"
            constraintName="fk_lead_notes_lead"
            onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>

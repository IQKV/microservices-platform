# Staging Environment Variables for Auth Service
SPRING_PROFILES_ACTIVE=staging

# Database Configuration
GRIPDAY_DATABASE_URL=jdbc:postgresql://postgres:5432/gripday_auth_staging
GRIPDAY_DATABASE_USERNAME=gripday_user
GRIPDAY_DATABASE_PASSWORD=${POSTGRES_PASSWORD}

# Redis Configuration
GRIPDAY_CACHE_REDIS_HOST=redis
GRIPDAY_CACHE_REDIS_PORT=6379
GRIPDAY_CACHE_REDIS_PASSWORD=${REDIS_PASSWORD}
GRIPDAY_CACHE_REDIS_DATABASE=1

# Authentication Configuration
GRIPDAY_AUTH_JWT_SECRET=${JWT_SECRET}
GRIPDAY_AUTH_OAUTH2_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GRIPDAY_AUTH_OAUTH2_GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
GRIPDAY_AUTH_OAUTH2_GOOGLE_ENABLED=false

# Observability Configuration
GRIPDAY_OBSERVABILITY_TRACING_ENDPOINT=http://jaeger:14268/api/traces

# PostgreSQL Database Configuration
POSTGRES_DB=gripday_auth_staging
POSTGRES_USER=gripday_user
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# Redis Configuration
REDIS_PASSWORD=${REDIS_PASSWORD}
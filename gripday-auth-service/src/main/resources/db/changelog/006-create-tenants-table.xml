<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="6.1" author="gripday-platform">
        <comment>Create tenants table for multi-tenant architecture support</comment>

        <createTable tableName="tenants">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="tenant_id" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>

            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="domain" type="VARCHAR(255)">
                <constraints nullable="true" unique="true"/>
            </column>

            <column name="subdomain" type="VARCHAR(100)">
                <constraints nullable="true" unique="true"/>
            </column>

            <column name="max_users" type="INTEGER">
                <constraints nullable="true"/>
            </column>

            <column name="storage_quota_gb" type="INTEGER">
                <constraints nullable="true"/>
            </column>

            <column name="api_rate_limit_per_minute" type="INTEGER">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="created_by" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="6.2" author="gripday-platform">
        <comment>Create indexes on tenants table for performance</comment>

        <createIndex indexName="idx_tenants_tenant_id" tableName="tenants">
            <column name="tenant_id"/>
        </createIndex>

        <createIndex indexName="idx_tenants_enabled" tableName="tenants">
            <column name="enabled"/>
        </createIndex>

        <createIndex indexName="idx_tenants_domain" tableName="tenants">
            <column name="domain"/>
        </createIndex>

        <createIndex indexName="idx_tenants_subdomain" tableName="tenants">
            <column name="subdomain"/>
        </createIndex>

        <createIndex indexName="idx_tenants_created_at" tableName="tenants">
            <column name="created_at"/>
        </createIndex>

        <createIndex indexName="idx_tenants_created_by" tableName="tenants">
            <column name="created_by"/>
        </createIndex>
    </changeSet>

    <changeSet id="6.3" author="gripday-platform">
        <comment>Insert default tenant for backward compatibility</comment>

        <insert tableName="tenants">
            <column name="tenant_id" value="default"/>
            <column name="name" value="Default Tenant"/>
            <column name="description" value="Default tenant for backward compatibility and system operations"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="created_by" value="system"/>
        </insert>
    </changeSet>

    <changeSet id="6.4" author="gripday-platform">
        <comment>Add check constraints for tenant configuration validation</comment>

        <sql>
            ALTER TABLE tenants
                ADD CONSTRAINT chk_tenants_max_users_positive
                    CHECK (max_users IS NULL OR max_users > 0);
        </sql>

        <sql>
            ALTER TABLE tenants
                ADD CONSTRAINT chk_tenants_storage_quota_positive
                    CHECK (storage_quota_gb IS NULL OR storage_quota_gb > 0);
        </sql>

        <sql>
            ALTER TABLE tenants
                ADD CONSTRAINT chk_tenants_rate_limit_positive
                    CHECK (api_rate_limit_per_minute IS NULL OR api_rate_limit_per_minute > 0);
        </sql>

        <sql>
            ALTER TABLE tenants
                ADD CONSTRAINT chk_tenants_tenant_id_format
                    CHECK (tenant_id ~ '^[a-zA-Z0-9][a-zA-Z0-9_-]*[a-zA-Z0-9]$' AND LENGTH (tenant_id) >= 3);
        </sql>
    </changeSet>

</databaseChangeLog>
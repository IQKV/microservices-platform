<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="2" author="gripday-platform">
        <comment>Create authorities table for role-based access control</comment>

        <createTable tableName="authorities">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="description" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Insert default authorities -->
        <insert tableName="authorities">
            <column name="name" value="USER"/>
            <column name="description" value="Standard user with basic access"/>
        </insert>

        <insert tableName="authorities">
            <column name="name" value="ADMIN"/>
            <column name="description" value="Administrator with user management access"/>
        </insert>

        <insert tableName="authorities">
            <column name="name" value="SUPER_ADMIN"/>
            <column name="description" value="Super administrator with full system access"/>
        </insert>

        <rollback>
            <dropTable tableName="authorities"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
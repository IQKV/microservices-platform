<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="4" author="gripday">
        <comment>Create user_audit_log table for security audit trail</comment>

        <createTable tableName="user_audit_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>

            <column name="action" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="details" type="TEXT">
                <constraints nullable="true"/>
            </column>

            <column name="ip_address" type="VARCHAR(45)">
                <constraints nullable="true"/>
            </column>

            <column name="user_agent" type="TEXT">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="tenant_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Add foreign key constraint to users table -->
        <addForeignKeyConstraint
                baseTableName="user_audit_log"
                baseColumnNames="user_id"
                constraintName="fk_user_audit_log_user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="SET NULL"/>

        <rollback>
            <dropTable tableName="user_audit_log"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
        }
      ]
    },
    {
      "name": "gripday.email.templates.registration-confirmed-template",
      "values": [
        {
          "value": "email/user-registration/email-confirmed.html",
          "description": "Default registration confirmation welcome email template"
        }
      ]
    }
  ]

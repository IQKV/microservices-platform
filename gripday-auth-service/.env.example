# Gripday Auth Service Environment Variables Template
# Copy this file to .env.local, .env.staging, or .env.production and configure values

# =============================================================================
# Database Configuration (gripday.database prefix)
# =============================================================================
GRIPDAY_DATABASE_URL=jdbc:postgresql://localhost:5432/gripday_auth_local
GRIPDAY_DATABASE_USERNAME=gripday_user
GRIPDAY_DATABASE_PASSWORD=gripday_password

# =============================================================================
# Redis Cache Configuration (gripday.cache.redis prefix)
# =============================================================================
GRIPDAY_CACHE_REDIS_HOST=localhost
GRIPDAY_CACHE_REDIS_PORT=6379
GRIPDAY_CACHE_REDIS_PASSWORD=
GRIPDAY_CACHE_REDIS_DATABASE=0

# =============================================================================
# Authentication Configuration (gripday.auth prefix)
# =============================================================================
GRIPDAY_AUTH_JWT_SECRET=your-jwt-secret-key-change-in-production
GRIPDAY_AUTH_OAUTH2_GOOGLE_CLIENT_ID=your-google-client-id
GRIPDAY_AUTH_OAUTH2_GOOGLE_CLIENT_SECRET=your-google-client-secret
GRIPDAY_AUTH_OAUTH2_GOOGLE_ENABLED=false

# =============================================================================
# Observability Configuration (gripday.observability prefix)
# =============================================================================
GRIPDAY_OBSERVABILITY_TRACING_ENDPOINT=http://localhost:4317

# =============================================================================
# Spring Profile Configuration
# =============================================================================
SPRING_PROFILES_ACTIVE=local

# =============================================================================
# Environment-Specific Examples
# =============================================================================

# Local Development Environment
# SPRING_PROFILES_ACTIVE=local
# GRIPDAY_DATABASE_URL=jdbc:postgresql://localhost:5432/gripday_auth_local
# GRIPDAY_CACHE_REDIS_HOST=localhost
# GRIPDAY_AUTH_JWT_SECRET=local-development-secret-key-not-for-production-use

# Staging Environment
# SPRING_PROFILES_ACTIVE=staging
# GRIPDAY_DATABASE_URL=jdbc:postgresql://staging-db:5432/gripday_auth_staging
# GRIPDAY_CACHE_REDIS_HOST=staging-redis
# GRIPDAY_AUTH_JWT_SECRET=${VAULT_JWT_SECRET}

# Production Environment
# SPRING_PROFILES_ACTIVE=production
# GRIPDAY_DATABASE_URL=jdbc:postgresql://prod-db:5432/gripday_auth_production
# GRIPDAY_CACHE_REDIS_HOST=prod-redis
# GRIPDAY_AUTH_JWT_SECRET=${VAULT_JWT_SECRET}
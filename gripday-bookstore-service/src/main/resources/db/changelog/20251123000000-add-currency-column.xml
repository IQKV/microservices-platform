<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- ========================================== -->
    <!-- ADD CURRENCY COLUMN FOR MONEY VALUE OBJECT -->
    <!-- ========================================== -->

    <changeSet id="20251123000000-001-add-currency-column" author="bookstore-service">
        <comment>Add currency column to support Money value object in DDD refactoring</comment>

        <addColumn tableName="books">
            <column name="currency" type="VARCHAR(3)" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <createIndex tableName="books" indexName="idx_books_currency">
            <column name="currency"/>
        </createIndex>

        <addCheckConstraint
                tableName="books"
                constraintName="chk_books_currency_valid"
                checkCondition="LENGTH(currency) = 3"/>
    </changeSet>

    <changeSet id="20251123000000-002-add-currency-price-index" author="bookstore-service">
        <comment>Add composite index for currency and price queries</comment>

        <createIndex tableName="books" indexName="idx_books_currency_price">
            <column name="currency"/>
            <column name="price"/>
        </createIndex>

        <createIndex tableName="books" indexName="idx_books_currency_available">
            <column name="currency"/>
            <column name="available"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

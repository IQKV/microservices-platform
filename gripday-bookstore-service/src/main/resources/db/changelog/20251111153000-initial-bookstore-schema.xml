<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- ========================================== -->
    <!-- INITIAL SCHEMA CREATION                    -->
    <!-- ========================================== -->

    <changeSet id="20251111153000-001-create-categories-table" author="bookstore-service">
        <createTable tableName="categories">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="categories" indexName="idx_categories_name">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="20251111153000-002-create-books-table" author="bookstore-service">
        <createTable tableName="books">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="author" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="isbn" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="available" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="books"
                baseColumnNames="category_id"
                constraintName="fk_books_category"
                referencedTableName="categories"
                referencedColumnNames="id"
                onDelete="SET NULL"/>

        <createIndex tableName="books" indexName="idx_books_title">
            <column name="title"/>
        </createIndex>

        <createIndex tableName="books" indexName="idx_books_author">
            <column name="author"/>
        </createIndex>

        <createIndex tableName="books" indexName="idx_books_isbn">
            <column name="isbn"/>
        </createIndex>

        <createIndex tableName="books" indexName="idx_books_category_id">
            <column name="category_id"/>
        </createIndex>

        <createIndex tableName="books" indexName="idx_books_available">
            <column name="available"/>
        </createIndex>

        <createIndex tableName="books" indexName="idx_books_price">
            <column name="price"/>
        </createIndex>
    </changeSet>

    <changeSet id="20251111153000-003-create-inventory-table" author="bookstore-service">
        <createTable tableName="inventory">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="book_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="quantity" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="reserved_quantity" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="low_stock_threshold" type="INTEGER" defaultValueNumeric="5">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="inventory"
                baseColumnNames="book_id"
                constraintName="fk_inventory_book"
                referencedTableName="books"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex tableName="inventory" indexName="idx_inventory_book_id">
            <column name="book_id"/>
        </createIndex>

        <createIndex tableName="inventory" indexName="idx_inventory_quantity">
            <column name="quantity"/>
        </createIndex>

        <addCheckConstraint
                tableName="inventory"
                constraintName="chk_inventory_quantity_non_negative"
                checkCondition="quantity >= 0"/>

        <addCheckConstraint
                tableName="inventory"
                constraintName="chk_inventory_reserved_quantity_non_negative"
                checkCondition="reserved_quantity >= 0"/>

        <addCheckConstraint
                tableName="inventory"
                constraintName="chk_inventory_reserved_not_exceed_quantity"
                checkCondition="reserved_quantity <= quantity"/>
    </changeSet>

    <!-- ========================================== -->
    <!-- PERFORMANCE INDEXES                        -->
    <!-- ========================================== -->

    <changeSet id="20251111153000-004-add-composite-search-indexes" author="bookstore-service">
        <comment>Add composite indexes for common search patterns and performance optimization</comment>

        <createIndex tableName="books" indexName="idx_books_available_category">
            <column name="available"/>
            <column name="category_id"/>
        </createIndex>

        <createIndex tableName="books" indexName="idx_books_available_price">
            <column name="available"/>
            <column name="price"/>
        </createIndex>

        <createIndex tableName="books" indexName="idx_books_available_title">
            <column name="available"/>
            <column name="title"/>
        </createIndex>

        <createIndex tableName="books" indexName="idx_books_available_author">
            <column name="available"/>
            <column name="author"/>
        </createIndex>

        <createIndex tableName="books" indexName="idx_books_available_created_at">
            <column name="available"/>
            <column name="created_at" descending="true"/>
        </createIndex>

        <sql>
            CREATE INDEX idx_books_title_lower ON books (LOWER(title));
        </sql>

        <sql>
            CREATE INDEX idx_books_author_lower ON books (LOWER(author));
        </sql>

        <sql>
            CREATE INDEX idx_books_available_only ON books (id, title, author, price, category_id, created_at) WHERE available = true;
        </sql>
    </changeSet>

    <changeSet id="20251111153000-005-add-inventory-performance-indexes" author="bookstore-service">
        <comment>Add indexes for inventory-related queries and low stock monitoring</comment>

        <createIndex tableName="inventory" indexName="idx_inventory_low_stock">
            <column name="quantity"/>
            <column name="low_stock_threshold"/>
        </createIndex>

        <createIndex tableName="inventory" indexName="idx_inventory_available_quantity">
            <column name="quantity"/>
            <column name="reserved_quantity"/>
        </createIndex>

        <sql>
            CREATE INDEX idx_inventory_out_of_stock ON inventory (book_id, quantity, updated_at) WHERE quantity = 0;
        </sql>

        <sql>
            CREATE INDEX idx_inventory_low_stock_items ON inventory (book_id, quantity, low_stock_threshold, updated_at) WHERE quantity <= low_stock_threshold AND quantity > 0;
        </sql>

        <createIndex tableName="inventory" indexName="idx_inventory_updated_at">
            <column name="updated_at" descending="true"/>
        </createIndex>
    </changeSet>

    <changeSet id="20251111153000-006-add-join-optimization-indexes" author="bookstore-service">
        <comment>Add indexes to optimize common JOIN operations between books and inventory</comment>

        <sql>
            CREATE INDEX idx_books_inventory_join ON books (id, available, title, author, price, category_id) WHERE available = true;
        </sql>

        <sql>
            CREATE INDEX idx_categories_books_join ON categories (id, name);
        </sql>

        <sql>
            CREATE INDEX idx_books_with_inventory ON books (id, available, created_at) WHERE available = true AND id IN (
                SELECT book_id FROM inventory WHERE quantity > 0
            );
        </sql>
    </changeSet>

    <changeSet id="20251111153000-007-add-search-optimization-indexes" author="bookstore-service">
        <comment>Add specialized indexes for search and filter operations</comment>

        <sql dbms="postgresql">
            CREATE INDEX idx_books_fulltext_search ON books
                USING gin(to_tsvector('english', title || ' ' || author))
                WHERE available = true;
        </sql>

        <sql dbms="postgresql">
            CREATE EXTENSION IF NOT EXISTS pg_trgm;
        </sql>

        <sql dbms="postgresql">
            CREATE INDEX idx_books_title_trgm ON books
                USING gin(title gin_trgm_ops)
                WHERE available = true;
        </sql>

        <sql dbms="postgresql">
            CREATE INDEX idx_books_author_trgm ON books
                USING gin(author gin_trgm_ops)
                WHERE available = true;
        </sql>

        <createIndex tableName="books" indexName="idx_books_price_range_available">
            <column name="price"/>
            <column name="available"/>
            <column name="category_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20251111153000-008-add-statistics-indexes" author="bookstore-service">
        <comment>Add indexes for statistics and reporting queries</comment>

        <createIndex tableName="books" indexName="idx_books_category_count">
            <column name="category_id"/>
            <column name="available"/>
        </createIndex>

        <createIndex tableName="inventory" indexName="idx_inventory_stats">
            <column name="quantity"/>
            <column name="reserved_quantity"/>
            <column name="book_id"/>
        </createIndex>

        <createIndex tableName="books" indexName="idx_books_audit">
            <column name="updated_at" descending="true"/>
            <column name="available"/>
        </createIndex>

        <createIndex tableName="inventory" indexName="idx_inventory_audit">
            <column name="updated_at" descending="true"/>
            <column name="quantity"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- QUERY OPTIMIZATION INDEXES                 -->
    <!-- ========================================== -->

    <changeSet id="20251111153000-009-add-repository-query-indexes" author="bookstore-service">
        <comment>Add indexes for specific repository query patterns</comment>

        <sql dbms="postgresql">
            CREATE INDEX idx_categories_name_lower ON categories (LOWER(name));
        </sql>

        <sql dbms="postgresql">
            CREATE INDEX idx_categories_name_trgm ON categories
                USING gin(name gin_trgm_ops);
        </sql>

        <createIndex tableName="books" indexName="idx_books_category_available">
            <column name="category_id"/>
            <column name="available"/>
            <column name="id"/>
        </createIndex>

        <createIndex tableName="categories" indexName="idx_categories_created_at">
            <column name="created_at" descending="true"/>
        </createIndex>
    </changeSet>

    <changeSet id="20251111153000-010-add-inventory-join-indexes" author="bookstore-service">
        <comment>Add indexes for inventory-book join queries and availability checks</comment>

        <sql dbms="postgresql">
            CREATE INDEX idx_inventory_available_calc ON inventory ((quantity - reserved_quantity))
                WHERE (quantity - reserved_quantity) > 0;
        </sql>

        <sql dbms="postgresql">
            CREATE INDEX idx_inventory_updated_at_desc ON inventory (updated_at DESC)
                WHERE updated_at IS NOT NULL;
        </sql>

        <createIndex tableName="inventory" indexName="idx_inventory_book_id_quantity">
            <column name="book_id"/>
            <column name="quantity"/>
            <column name="reserved_quantity"/>
        </createIndex>
    </changeSet>

    <changeSet id="20251111153000-011-add-book-search-optimization-indexes" author="bookstore-service">
        <comment>Add indexes for complex book search queries with multiple filters</comment>

        <createIndex tableName="books" indexName="idx_books_price_category_available">
            <column name="price"/>
            <column name="category_id"/>
            <column name="available"/>
        </createIndex>

        <sql dbms="postgresql">
            CREATE INDEX idx_books_recent_available ON books (created_at DESC, id)
                WHERE available = true;
        </sql>

        <sql dbms="postgresql">
            CREATE INDEX idx_books_in_stock ON books (id, title, author, price, category_id)
                WHERE available = true AND EXISTS (
                    SELECT 1 FROM inventory i WHERE i.book_id = books.id AND i.quantity > 0
                );
        </sql>

        <sql dbms="postgresql">
            CREATE INDEX idx_books_title_available_lower ON books (LOWER(title), available, id)
                WHERE available = true;
        </sql>

        <sql dbms="postgresql">
            CREATE INDEX idx_books_author_available_lower ON books (LOWER(author), available, id)
                WHERE available = true;
        </sql>
    </changeSet>

    <changeSet id="20251111153000-012-add-category-inventory-join-indexes" author="bookstore-service">
        <comment>Add indexes for category-based inventory queries</comment>

        <createIndex tableName="books" indexName="idx_books_category_id_available_id">
            <column name="category_id"/>
            <column name="available"/>
            <column name="id"/>
        </createIndex>

        <createIndex tableName="inventory" indexName="idx_inventory_quantity_threshold_book">
            <column name="quantity"/>
            <column name="low_stock_threshold"/>
            <column name="book_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20251111153000-013-add-isbn-lookup-optimization" author="bookstore-service">
        <comment>Optimize ISBN lookups which are unique and frequently used</comment>

        <sql dbms="postgresql">
            CREATE INDEX idx_books_isbn_covering ON books (isbn, id, title, author, price, available)
                WHERE isbn IS NOT NULL;
        </sql>

        <sql dbms="postgresql">
            CREATE INDEX idx_inventory_book_isbn ON inventory (book_id)
                INCLUDE (quantity, reserved_quantity, low_stock_threshold);
        </sql>
    </changeSet>

    <changeSet id="20251111153000-014-add-statistics-query-indexes" author="bookstore-service">
        <comment>Add indexes for count and sum aggregation queries</comment>

        <sql dbms="postgresql">
            CREATE INDEX idx_books_available_count ON books (available)
                WHERE available = true;
        </sql>

        <sql dbms="postgresql">
            CREATE INDEX idx_inventory_reserved_count ON inventory (reserved_quantity)
                WHERE reserved_quantity > 0;
        </sql>

        <sql dbms="postgresql">
            CREATE INDEX idx_inventory_quantity_sum ON inventory (quantity)
                WHERE quantity > 0;
        </sql>
    </changeSet>

</databaseChangeLog>

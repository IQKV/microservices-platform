{
  "groups": [
    {
      "name": "gripday.bookstore",
      "type": "org.gripday.bookstore.infrastructure.security.CorsConfiguration",
      "description": "Configuration properties for Gripday Bookstore Service with gripday.bookstore prefix"
    },
    {
      "name": "gripday.bookstore.cors",
      "type": "org.gripday.bookstore.infrastructure.security.CorsConfiguration",
      "description": "CORS configuration properties for the bookstore service"
    }
  ],
  "properties": [
    {
      "name": "gripday.bookstore.cors.allowed-origins",
      "type": "java.lang.String[]",
      "description": "Comma-separated list of allowed origins for CORS requests",
      "sourceType": "org.gripday.bookstore.infrastructure.security.CorsConfiguration",
      "defaultValue": "http://localhost:5173,http://localhost:3000"
    },
    {
      "name": "gripday.bookstore.cors.allowed-methods",
      "type": "java.lang.String[]",
      "description": "Comma-separated list of allowed HTTP methods for CORS requests",
      "sourceType": "org.gripday.bookstore.infrastructure.security.CorsConfiguration",
      "defaultValue": "GET,POST,PUT,DELETE,OPTIONS"
    },
    {
      "name": "gripday.bookstore.cors.allowed-headers",
      "type": "java.lang.String[]",
      "description": "Comma-separated list of allowed headers for CORS requests. Use '*' to allow all headers",
      "sourceType": "org.gripday.bookstore.infrastructure.security.CorsConfiguration",
      "defaultValue": "*"
    },
    {
      "name": "gripday.bookstore.cors.allow-credentials",
      "type": "java.lang.Boolean",
      "description": "Whether to allow credentials (cookies, authorization headers) in CORS requests",
      "sourceType": "org.gripday.bookstore.infrastructure.security.CorsConfiguration",
      "defaultValue": true
    },
    {
      "name": "gripday.bookstore.cors.max-age",
      "type": "java.lang.Long",
      "description": "Maximum age in seconds for preflight request caching",
      "sourceType": "org.gripday.bookstore.infrastructure.security.CorsConfiguration",
      "defaultValue": 3600
    }
  ],
  "hints": [
    {
      "name": "gripday.bookstore.cors.allowed-origins",
      "values": [
        {
          "value": "http://localhost:3000",
          "description": "React development server (default port)"
        },
        {
          "value": "http://localhost:5173",
          "description": "Vite development server (default port)"
        },
        {
          "value": "https://bookstore.gripday.com",
          "description": "Production frontend domain"
        },
        {
          "value": "*",
          "description": "Allow all origins (not recommended for production)"
        }
      ]
    },
    {
      "name": "gripday.bookstore.cors.allowed-methods",
      "values": [
        {
          "value": "GET,POST,PUT,DELETE,OPTIONS",
          "description": "Standard REST API methods"
        },
        {
          "value": "GET,POST,PUT,DELETE,PATCH,OPTIONS",
          "description": "REST API methods including PATCH"
        }
      ]
    },
    {
      "name": "gripday.bookstore.cors.allowed-headers",
      "values": [
        {
          "value": "*",
          "description": "Allow all headers (simplest configuration)"
        },
        {
          "value": "Content-Type,Authorization,X-Requested-With,X-Correlation-ID",
          "description": "Common headers for REST APIs"
        }
      ]
    },
    {
      "name": "gripday.bookstore.cors.max-age",
      "values": [
        {
          "value": "3600",
          "description": "1 hour (recommended for development)"
        },
        {
          "value": "86400",
          "description": "24 hours (recommended for production)"
        },
        {
          "value": "0",
          "description": "Disable preflight caching"
        }
      ]
    }
  ]
}

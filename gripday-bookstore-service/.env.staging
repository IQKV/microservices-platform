# Staging environment variables
# Database Configuration
DB_HOST=bookstore-db-staging
DB_PORT=5432
DB_NAME=bookstore_db
DB_USERNAME=bookstore_user
DB_PASSWORD=

# Redis Configuration
REDIS_HOST=bookstore-redis-staging
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_ISSUER_URI=https://auth.pynity.website/auth/realms/gripday

# Server Configuration
SERVER_PORT=8082

# JVM Configuration
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Xms512m -Xmx1g
<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="20251205000400-000001-create-invoices-table" author="iqscaffold">
        <comment>Create invoices table for invoice generation and management</comment>

        <createTable tableName="invoices">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="subscription_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>

            <column name="tenant_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="invoice_number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="subtotal" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>

            <column name="tax" type="DECIMAL(10,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>

            <column name="total" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>

            <column name="currency" type="VARCHAR(3)" defaultValue="USD">
                <constraints nullable="false"/>
            </column>

            <column name="period_start" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="period_end" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="due_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="paid_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>

            <column name="payment_method_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>

            <column name="provider_invoice_id" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>

            <column name="line_items" type="JSONB">
                <constraints nullable="true"/>
            </column>

            <column name="metadata" type="JSONB">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20251205000400-000002-add-invoices-indexes" author="iqscaffold">
        <comment>Create indexes on invoices table for query performance</comment>

        <createIndex indexName="idx_invoices_subscription_id" tableName="invoices">
            <column name="subscription_id"/>
        </createIndex>

        <createIndex indexName="idx_invoices_tenant_id" tableName="invoices">
            <column name="tenant_id"/>
        </createIndex>

        <createIndex indexName="idx_invoices_invoice_number" tableName="invoices">
            <column name="invoice_number"/>
        </createIndex>

        <createIndex indexName="idx_invoices_status" tableName="invoices">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_invoices_due_date" tableName="invoices">
            <column name="due_date"/>
        </createIndex>

        <createIndex indexName="idx_invoices_period" tableName="invoices">
            <column name="period_start"/>
            <column name="period_end"/>
        </createIndex>

        <createIndex indexName="idx_invoices_created_at" tableName="invoices">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="20251205000400-000003-add-invoices-constraints" author="iqscaffold">
        <comment>Add foreign key and check constraints to invoices table</comment>

        <addForeignKeyConstraint
                baseTableName="invoices"
                baseColumnNames="subscription_id"
                constraintName="fk_invoices_subscription"
                referencedTableName="subscriptions"
                referencedColumnNames="id"
                onDelete="SET NULL"/>

        <addForeignKeyConstraint
                baseTableName="invoices"
                baseColumnNames="payment_method_id"
                constraintName="fk_invoices_payment_method"
                referencedTableName="payment_methods"
                referencedColumnNames="id"
                onDelete="SET NULL"/>

        <sql>
            ALTER TABLE invoices
                ADD CONSTRAINT chk_invoices_status
                    CHECK (status IN ('DRAFT', 'OPEN', 'PAID', 'VOID', 'UNCOLLECTIBLE'));

            ALTER TABLE invoices
                ADD CONSTRAINT chk_invoices_amounts_non_negative
                    CHECK (subtotal >= 0 AND tax >= 0 AND total >= 0);

            ALTER TABLE invoices
                ADD CONSTRAINT chk_invoices_total_calculation
                    CHECK (total = subtotal + tax);
        </sql>

        <rollback>
            <dropForeignKeyConstraint baseTableName="invoices" constraintName="fk_invoices_subscription"/>
            <dropForeignKeyConstraint baseTableName="invoices" constraintName="fk_invoices_payment_method"/>
            <sql>
                ALTER TABLE invoices DROP CONSTRAINT IF EXISTS chk_invoices_status;
                ALTER TABLE invoices DROP CONSTRAINT IF EXISTS chk_invoices_amounts_non_negative;
                ALTER TABLE invoices DROP CONSTRAINT IF EXISTS chk_invoices_total_calculation;
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>

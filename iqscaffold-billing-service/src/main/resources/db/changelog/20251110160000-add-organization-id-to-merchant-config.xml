<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="20251110160000-add-organization-id" author="iqscaffold" context="public">
        <comment>Add organization_id to merchant_stripe_config for user service integration</comment>

        <addColumn tableName="merchant_stripe_config" schemaName="public">
            <column name="organization_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <createIndex indexName="idx_merchant_config_organization_id" 
                     tableName="merchant_stripe_config" 
                     schemaName="public">
            <column name="organization_id"/>
        </createIndex>

        <addUniqueConstraint 
                tableName="merchant_stripe_config"
                columnNames="organization_id"
                constraintName="uq_merchant_config_organization_id"
                schemaName="public"/>

        <rollback>
            <dropUniqueConstraint tableName="merchant_stripe_config" 
                                  constraintName="uq_merchant_config_organization_id"
                                  schemaName="public"/>
            <dropIndex indexName="idx_merchant_config_organization_id" 
                       tableName="merchant_stripe_config"
                       schemaName="public"/>
            <dropColumn tableName="merchant_stripe_config" 
                        columnName="organization_id"
                        schemaName="public"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

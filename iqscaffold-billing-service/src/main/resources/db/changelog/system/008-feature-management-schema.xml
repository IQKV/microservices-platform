<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="008-001-create-feature-definition-table" author="system">
    <comment>Create feature_definition table for platform-wide feature definitions</comment>
    
    <createTable tableName="feature_definition" schemaName="public">
      <column name="feature_key" type="varchar(100)">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="display_name" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="description" type="text"/>
      <column name="type" type="varchar(20)">
        <constraints nullable="false"/>
      </column>
      <column name="category" type="varchar(100)"/>
      <column name="metadata" type="jsonb"/>
      <column name="dependencies" type="jsonb"/>
      <column name="deprecated" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="deprecation_message" type="varchar(500)"/>
      <column name="sort_order" type="integer"/>
      <column name="created_at" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="varchar(100)"/>
      <column name="updated_by" type="varchar(100)"/>
    </createTable>

    <!-- Indexes for performance -->
    <createIndex tableName="feature_definition" indexName="idx_feature_definition_type" schemaName="public">
      <column name="type"/>
    </createIndex>
    
    <createIndex tableName="feature_definition" indexName="idx_feature_definition_category" schemaName="public">
      <column name="category"/>
    </createIndex>
    
    <createIndex tableName="feature_definition" indexName="idx_feature_definition_deprecated" schemaName="public">
      <column name="deprecated"/>
    </createIndex>
    
    <createIndex tableName="feature_definition" indexName="idx_feature_definition_sort_order" schemaName="public">
      <column name="sort_order"/>
    </createIndex>

    <!-- Add constraint for valid feature types -->
    <sql>
      ALTER TABLE public.feature_definition 
      ADD CONSTRAINT chk_feature_type 
      CHECK (type IN ('BOOLEAN', 'QUOTA', 'LIMIT', 'TIER'));
    </sql>
  </changeSet>

  <changeSet id="008-002-create-plan-feature-table" author="system">
    <comment>Create plan_feature table for plan-feature associations</comment>
    
    <createTable tableName="plan_feature" schemaName="public">
      <column name="plan_id" type="uuid">
        <constraints nullable="false"/>
      </column>
      <column name="feature_key" type="varchar(100)">
        <constraints nullable="false"/>
      </column>
      <column name="enabled" type="boolean" defaultValueBoolean="true">
        <constraints nullable="false"/>
      </column>
      <column name="configuration" type="jsonb"/>
      <column name="created_at" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="varchar(100)"/>
      <column name="updated_by" type="varchar(100)"/>
    </createTable>

    <!-- Composite primary key -->
    <addPrimaryKey tableName="plan_feature" columnNames="plan_id,feature_key" schemaName="public"/>

    <!-- Foreign key constraints -->
    <addForeignKeyConstraint
        baseTableName="plan_feature"
        baseColumnNames="plan_id"
        baseTableSchemaName="public"
        referencedTableName="subscription_plan"
        referencedColumnNames="id"
        referencedTableSchemaName="public"
        constraintName="fk_plan_feature_plan_id"
        onDelete="CASCADE"/>

    <addForeignKeyConstraint
        baseTableName="plan_feature"
        baseColumnNames="feature_key"
        baseTableSchemaName="public"
        referencedTableName="feature_definition"
        referencedColumnNames="feature_key"
        referencedTableSchemaName="public"
        constraintName="fk_plan_feature_feature_key"
        onDelete="CASCADE"/>

    <!-- Indexes for performance -->
    <createIndex tableName="plan_feature" indexName="idx_plan_feature_plan_id" schemaName="public">
      <column name="plan_id"/>
    </createIndex>
    
    <createIndex tableName="plan_feature" indexName="idx_plan_feature_feature_key" schemaName="public">
      <column name="feature_key"/>
    </createIndex>
    
    <createIndex tableName="plan_feature" indexName="idx_plan_feature_enabled" schemaName="public">
      <column name="enabled"/>
    </createIndex>
  </changeSet>

  <changeSet id="008-003-insert-default-features" author="system">

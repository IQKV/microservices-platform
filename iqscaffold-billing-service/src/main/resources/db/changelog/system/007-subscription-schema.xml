<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Subscription Plan Table (Platform-wide plans) -->
    <changeSet id="007-subscription-plan-table" author="iqscaffold">
        <createTable tableName="subscription_plan" schemaName="public">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="amount" type="decimal(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="varchar(3)">
                <constraints nullable="false"/>
            </column>
            <column name="interval" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="interval_count" type="int" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="trial_period_days" type="int" defaultValueNumeric="0"/>
            <column name="stripe_product_id" type="varchar(255)"/>
            <column name="stripe_price_id" type="varchar(255)"/>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="features" type="jsonb"/>
            <column name="max_users" type="int"/>
            <column name="max_storage_gb" type="int"/>
            <column name="max_api_calls" type="bigint"/>
            <column name="metadata" type="jsonb"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="subscription_plan" indexName="idx_subscription_plan_stripe_price_id" schemaName="public">
            <column name="stripe_price_id"/>
        </createIndex>
        <createIndex tableName="subscription_plan" indexName="idx_subscription_plan_is_active" schemaName="public">
            <column name="is_active"/>
        </createIndex>
    </changeSet>

    <!-- Tenant Subscription Table -->
    <changeSet id="007-tenant-subscription-table" author="iqscaffold">
        <createTable tableName="tenant_subscription" schemaName="public">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="plan_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_tenant_subscription_plan"
                            references="subscription_plan(id)"/>
            </column>
            <column name="organization_id" type="bigint"/>
            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="stripe_subscription_id" type="varchar(255)"/>
            <column name="stripe_customer_id" type="varchar(255)"/>
            <column name="current_period_start" type="timestamp"/>
            <column name="current_period_end" type="timestamp"/>
            <column name="trial_end" type="timestamp"/>
            <column name="cancel_at" type="timestamp"/>
            <column name="canceled_at" type="timestamp"/>
            <column name="cancellation_reason" type="text"/>
            <column name="metadata" type="jsonb"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="tenant_subscription" indexName="idx_tenant_subscription_tenant_id" schemaName="public">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="tenant_subscription" indexName="idx_tenant_subscription_organization_id" schemaName="public">
            <column name="organization_id"/>
        </createIndex>
        <createIndex tableName="tenant_subscription" indexName="idx_tenant_subscription_stripe_subscription_id" schemaName="public" unique="true">
            <column name="stripe_subscription_id"/>
        </createIndex>
        <createIndex tableName="tenant_subscription" indexName="idx_tenant_subscription_status" schemaName="public">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="tenant_subscription" indexName="idx_tenant_subscription_plan_id" schemaName="public">
            <column name="plan_id"/>
        </createIndex>
    </changeSet>

    <!-- Subscription Invoice Table -->
    <changeSet id="007-subscription-invoice-table" author="iqscaffold">
        <createTable tableName="subscription_invoice" schemaName="public">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_subscription_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_subscription_invoice_tenant_subscription"
                            references="tenant_subscription(id)"/>
            </column>
            <column name="tenant_id" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_number" type="varchar(100)"/>
            <column name="amount_due" type="decimal(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="amount_paid" type="decimal(19, 2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="varchar(3)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="due_date" type="timestamp"/>
            <column name="paid_at" type="timestamp"/>
            <column name="stripe_invoice_id" type="varchar(255)"/>
            <column name="hosted_invoice_url" type="varchar(500)"/>
            <column name="invoice_pdf_url" type="varchar(500)"/>
            <column name="metadata" type="jsonb"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="subscription_invoice" indexName="idx_subscription_invoice_tenant_subscription_id" schemaName="public">
            <column name="tenant_subscription_id"/>
        </createIndex>
        <createIndex tableName="subscription_invoice" indexName="idx_subscription_invoice_tenant_id" schemaName="public">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="subscription_invoice" indexName="idx_subscription_invoice_stripe_invoice_id" schemaName="public" unique="true">
            <column name="stripe_invoice_id"/>
        </createIndex>
        <createIndex tableName="subscription_invoice" indexName="idx_subscription_invoice_status" schemaName="public">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="subscription_invoice" indexName="idx_subscription_invoice_due_date" schemaName="public">
            <column name="due_date"/>
        </createIndex>
    </changeSet>

    <!-- Subscription Item Table (Line items for subscriptions) -->
    <changeSet id="007-subscription-item-table" author="iqscaffold">
        <createTable tableName="subscription_item" schemaName="public">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_subscription_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_subscription_item_tenant_subscription"
                            references="tenant_subscription(id)"/>
            </column>
            <column name="plan_id" type="uuid">
                <constraints foreignKeyName="fk_subscription_item_plan"
                            references="subscription_plan(id)"/>
            </column>
            <column name="quantity" type="int" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="unit_amount" type="decimal(19, 2)"/>
            <column name="stripe_subscription_item_id" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="subscription_item" indexName="idx_subscription_item_tenant_subscription_id" schemaName="public">
            <column name="tenant_subscription_id"/>
        </createIndex>
        <createIndex tableName="subscription_item" indexName="idx_subscription_item_stripe_subscription_item_id" schemaName="public">
            <column name="stripe_subscription_item_id"/>
        </createIndex>
    </changeSet>

    <!-- Tenant Subscription Audit Trail Table -->
    <changeSet id="007-tenant-subscription-audit-trail-table" author="iqscaffold">
        <createTable tableName="tenant_subscription_audit_trail" schemaName="public">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_subscription_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_tenant_subscription_audit_trail_tenant_subscription"
                            references="tenant_subscription(id)"/>
            </column>
            <column name="tenant_id" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="old_status" type="varchar(50)"/>
            <column name="new_status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="changed_by" type="varchar(255)"/>
            <column name="reason" type="text"/>
            <column name="metadata" type="jsonb"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="tenant_subscription_audit_trail" indexName="idx_tenant_subscription_audit_trail_tenant_subscription_id" schemaName="public">
            <column name="tenant_subscription_id"/>
        </createIndex>
        <createIndex tableName="tenant_subscription_audit_trail" indexName="idx_tenant_subscription_audit_trail_created_at" schemaName="public">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- 
        Subscription Plan Table (Platform-wide plans)
        
        This table remains in the public schema as it contains platform-wide
        product definitions that are shared across all tenants.
        
        Tenant-specific subscription data (tenant_subscription, subscription_invoice, etc.)
        has been moved to tenant-specific schemas. See:
        - db/changelog/tenant/001-tenant-subscription-schema.xml
    -->
    <changeSet id="007-subscription-plan-table" author="iqscaffold">
        <createTable tableName="subscription_plan" schemaName="public">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="amount" type="decimal(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="varchar(3)">
                <constraints nullable="false"/>
            </column>
            <column name="subscription_interval" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="interval_count" type="int" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="trial_period_days" type="int" defaultValueNumeric="0"/>
            <column name="stripe_product_id" type="varchar(255)"/>
            <column name="stripe_price_id" type="varchar(255)"/>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="max_users" type="int"/>
            <column name="max_storage_gb" type="int"/>
            <column name="max_api_calls" type="bigint"/>
            <column name="metadata" type="jsonb"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="subscription_plan" indexName="idx_subscription_plan_stripe_price_id" schemaName="public">
            <column name="stripe_price_id"/>
        </createIndex>
        <createIndex tableName="subscription_plan" indexName="idx_subscription_plan_is_active" schemaName="public">
            <column name="is_active"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

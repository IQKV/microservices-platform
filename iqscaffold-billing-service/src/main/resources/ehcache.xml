<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.10.xsd">

    <!-- Default cache template -->
    <cache-template name="default">
        <expiry>
            <ttl unit="minutes">10</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
            <offheap unit="MB">10</offheap>
        </resources>
    </cache-template>

    <!-- Entity cache template for frequently accessed entities -->
    <cache-template name="entity-cache">
        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>
        <resources>
            <heap unit="entries">2000</heap>
            <offheap unit="MB">20</offheap>
        </resources>
    </cache-template>

    <!-- Query cache template -->
    <cache-template name="query-cache">
        <expiry>
            <ttl unit="minutes">5</ttl>
        </expiry>
        <resources>
            <heap unit="entries">500</heap>
            <offheap unit="MB">5</offheap>
        </resources>
    </cache-template>

    <!-- Payment entity cache -->
    <cache alias="com.iqscaffold.billingservice.payment.Payment" uses-template="entity-cache">
        <expiry>
            <ttl unit="minutes">15</ttl>
        </expiry>
        <resources>
            <heap unit="entries">5000</heap>
            <offheap unit="MB">50</offheap>
        </resources>
    </cache>

    <!-- StripeCustomer entity cache -->
    <cache alias="com.iqscaffold.billingservice.payment.StripeCustomer" uses-template="entity-cache">
        <expiry>
            <ttl unit="minutes">60</ttl>
        </expiry>
        <resources>
            <heap unit="entries">3000</heap>
            <offheap unit="MB">30</offheap>
        </resources>
    </cache>

    <!-- Payout entity cache -->
    <cache alias="com.iqscaffold.billingservice.payout.Payout" uses-template="entity-cache">
        <expiry>
            <ttl unit="minutes">20</ttl>
        </expiry>
        <resources>
            <heap unit="entries">2000</heap>
            <offheap unit="MB">20</offheap>
        </resources>
    </cache>

    <!-- MerchantStripeConfig entity cache -->
    <cache alias="com.iqscaffold.billingservice.admin.MerchantStripeConfig" uses-template="entity-cache">
        <expiry>
            <ttl unit="hours">2</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
            <offheap unit="MB">10</offheap>
        </resources>
    </cache>

    <!-- PaymentGatewayConfig entity cache -->
    <cache alias="com.iqscaffold.billingservice.admin.PaymentGatewayConfig" uses-template="entity-cache">
        <expiry>
            <ttl unit="hours">1</ttl>
        </expiry>
        <resources>
            <heap unit="entries">500</heap>
            <offheap unit="MB">5</offheap>
        </resources>
    </cache>

    <!-- Gateway configuration service cache -->
    <cache alias="gatewayConfigs">
        <expiry>
            <ttl unit="hours">1</ttl>
        </expiry>
        <resources>
            <heap unit="entries">500</heap>
        </resources>
    </cache>

    <!-- Default query results cache -->
    <cache alias="default-query-results-region" uses-template="query-cache"/>

    <!-- Default update timestamps cache -->
    <cache alias="default-update-timestamps-region">
        <expiry>
            <none/>
        </expiry>
        <resources>
            <heap unit="entries">5000</heap>
        </resources>
    </cache>

</config>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20250121000001-demo-pipeline-followups-activities" author="iqscaffold" context="demo">
        <comment>Create demo follow-ups and pipeline activities for the demo pipeline items</comment>

        <!-- Follow-ups for David Kim (Qualified Lead) -->
        <!-- Scheduled follow-up for proposal presentation -->
        <insert tableName="follow_ups">
            <column name="pipeline_item_id" valueComputed="(SELECT id FROM pipeline_items WHERE lead_id = 1001)"/>
            <column name="title" value="Proposal Presentation"/>
            <column name="description" value="Present comprehensive solution proposal including enterprise features, implementation timeline, and pricing structure"/>
            <column name="scheduled_date" valueDate="2025-01-25T14:00:00Z"/>
            <column name="status" value="SCHEDULED"/>
            <column name="priority" value="HIGH"/>
            <column name="assigned_to" value="admin"/>
            <column name="created_by" value="admin"/>
            <column name="updated_by" value="admin"/>
        </insert>

        <!-- Follow-up for technical requirements discussion -->
        <insert tableName="follow_ups">
            <column name="pipeline_item_id" valueComputed="(SELECT id FROM pipeline_items WHERE lead_id = 1001)"/>
            <column name="title" value="Technical Requirements Review"/>
            <column name="description" value="Deep dive into technical requirements, integration needs, and security compliance requirements"/>
            <column name="scheduled_date" valueDate="2025-01-28T10:30:00Z"/>
            <column name="status" value="SCHEDULED"/>
            <column name="priority" value="MEDIUM"/>
            <column name="assigned_to" value="manager"/>
            <column name="created_by" value="admin"/>
            <column name="updated_by" value="admin"/>
        </insert>

        <!-- Follow-ups for Lisa Thompson (New Lead) -->
        <!-- Initial discovery call follow-up -->
        <insert tableName="follow_ups">
            <column name="pipeline_item_id" valueComputed="(SELECT id FROM pipeline_items WHERE lead_id = 1003)"/>
            <column name="title" value="Discovery Call"/>
            <column name="description" value="Initial discovery call to understand startup needs, budget constraints, and growth timeline"/>
            <column name="scheduled_date" valueDate="2025-01-23T15:00:00Z"/>
            <column name="status" value="SCHEDULED"/>
            <column name="priority" value="MEDIUM"/>
            <column name="assigned_to" value="manager"/>
            <column name="created_by" value="manager"/>
            <column name="updated_by" value="manager"/>
        </insert>

        <!-- Pipeline Activities for David Kim -->
        <!-- Stage progression activity -->
        <insert tableName="pipeline_activities">
            <column name="pipeline_item_id" valueComputed="(SELECT id FROM pipeline_items WHERE lead_id = 1001)"/>
            <column name="activity_type" value="STAGE_CHANGE"/>
            <column name="description" value="Lead moved from 'Contacted' to 'Qualified' stage after successful needs assessment call"/>
            <column name="performed_by" value="admin"/>
            <column name="performed_at" valueDate="2024-12-18T10:30:00Z"/>
            <column name="metadata" value="{'previous_stage': 'Contacted', 'new_stage': 'Qualified', 'reason': 'Budget confirmed, decision maker identified'}"/>
        </insert>

        <!-- Value update activity -->
        <insert tableName="pipeline_activities">
            <column name="pipeline_item_id" valueComputed="(SELECT id FROM pipeline_items WHERE lead_id = 1001)"/>
            <column name="activity_type" value="VALUE_UPDATE"/>
            <column name="description" value="Expected deal value updated based on expanded scope discussion"/>
            <column name="performed_by" value="admin"/>
            <column name="performed_at" valueDate="2025-01-10T09:15:00Z"/>
            <column name="metadata" value="{'previous_value': 75000.00, 'new_value': 85000.00, 'reason': 'Additional modules requested'}"/>
        </insert>

        <!-- Pipeline Activities for Michael Rodriguez -->
        <!-- Conversion activity -->
        <insert tableName="pipeline_activities">
            <column name="pipeline_item_id" valueComputed="(SELECT id FROM pipeline_items WHERE lead_id = 1002)"/>
            <column name="activity_type" value="CONVERSION"/>
            <column name="description" value="Lead successfully converted to customer - contract signed and payment processed"/>
            <column name="performed_by" value="billing"/>
            <column name="performed_at" valueDate="2024-11-15T16:30:00Z"/>
            <column name="metadata" value="{'contract_value': 180000.00, 'payment_method': 'wire_transfer', 'contract_id': 'CONT-2024-1115-001'}"/>
        </insert>

        <!-- Stage progression to Won -->
        <insert tableName="pipeline_activities">
            <column name="pipeline_item_id" valueComputed="(SELECT id FROM pipeline_items WHERE lead_id = 1002)"/>
            <column name="activity_type" value="STAGE_CHANGE"/>
            <column name="description" value="Lead moved to 'Won' stage following successful contract execution"/>
            <column name="performed_by" value="billing"/>
            <column name="performed_at" valueDate="2024-11-15T16:30:00Z"/>
            <column name="metadata" value="{'previous_stage': 'Proposal', 'new_stage': 'Won', 'conversion_rate': '100%'}"/>
        </insert>

        <!-- Pipeline Activities for Lisa Thompson -->
        <!-- Initial entry activity -->
        <insert tableName="pipeline_activities">
            <column name="pipeline_item_id" valueComputed="(SELECT id FROM pipeline_items WHERE lead_id = 1003)"/>
            <column name="activity_type" value="LEAD_CREATED"/>
            <column name="description" value="New lead entered pipeline from website contact form"/>
            <column name="performed_by" value="manager"/>
            <column name="performed_at" valueDate="2025-01-20T14:15:00Z"/>
            <column name="metadata" value="{'source': 'website_form', 'initial_interest': 'startup_package', 'company_size': '5-10'}"/>
        </insert>

        <rollback>
            <!-- Remove pipeline activities -->
            <delete tableName="pipeline_activities">
                <where>pipeline_item_id IN (
                    SELECT id FROM pipeline_items WHERE lead_id IN (1001, 1002, 1003)
                )</where>
            </delete>
            
            <!-- Remove follow-ups -->
            <delete tableName="follow_ups">
                <where>pipeline_item_id IN (
                    SELECT id FROM pipeline_items WHERE lead_id IN (1001, 1002, 1003)
                )</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
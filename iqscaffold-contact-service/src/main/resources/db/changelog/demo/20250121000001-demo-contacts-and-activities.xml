<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20250121000001-demo-contacts-and-activities" author="iqscaffold" context="demo">
        <comment>Create demo contacts and activities for the demo companies with various lead scores and statuses</comment>

        <!-- 1. High-Value Lead Contact at TechCorp Industries -->
        <!-- Sarah Chen - CTO at TechCorp, high lead score, actively engaged -->
        <insert tableName="contacts">
            <column name="first_name" value="Sarah"/>
            <column name="last_name" value="Chen"/>
            <column name="email" value="sarah.chen@techcorp-industries.com"/>
            <column name="phone" value="+1-555-0201"/>
            <column name="job_title" value="Chief Technology Officer"/>
            <column name="company_id" valueComputed="(SELECT id FROM companies WHERE name = 'TechCorp Industries')"/>
            <column name="status" value="LEAD"/>
            <column name="lead_score" value="85"/>
            <column name="notes" value="Highly engaged CTO with decision-making authority. Attended our product demo on Dec 10, 2024. Downloaded technical whitepaper and requested POC. Strong technical background, understands our value proposition. Key decision maker for Q1 2025 purchase."/>
            <column name="created_by" value="admin"/>
            <column name="updated_by" value="admin"/>
        </insert>

        <!-- 2. Converted Customer Contact at Global Retail Solutions -->
        <!-- Michael Rodriguez - VP of IT, converted from lead to customer -->
        <insert tableName="contacts">
            <column name="first_name" value="Michael"/>
            <column name="last_name" value="Rodriguez"/>
            <column name="email" value="m.rodriguez@globalretail.com"/>
            <column name="phone" value="+1-555-0301"/>
            <column name="job_title" value="Vice President of Information Technology"/>
            <column name="company_id" valueComputed="(SELECT id FROM companies WHERE name = 'Global Retail Solutions')"/>
            <column name="status" value="CUSTOMER"/>
            <column name="lead_score" value="95"/>
            <column name="converted_from_lead_id" value="12345"/>
            <column name="converted_at" valueDate="2024-11-15T16:30:00Z"/>
            <column name="notes" value="Successfully converted from lead to customer in November 2024. Led the evaluation process for their CRM modernization project. Excellent relationship, very satisfied with our platform. Potential advocate for expansion to other business units."/>
            <column name="created_by" value="admin"/>
            <column name="updated_by" value="billing"/>
        </insert>

        <!-- 3. Strategic Partner Contact at StartupHub Accelerator -->
        <!-- Jennifer Park - Partnership Director, active partner relationship -->
        <insert tableName="contacts">
            <column name="first_name" value="Jennifer"/>
            <column name="last_name" value="Park"/>
            <column name="email" value="jennifer.park@startuphub.io"/>
            <column name="phone" value="+1-555-0401"/>
            <column name="job_title" value="Director of Strategic Partnerships"/>
            <column name="company_id" valueComputed="(SELECT id FROM companies WHERE name = 'StartupHub Accelerator')"/>
            <column name="status" value="ACTIVE"/>
            <column name="lead_score" value="70"/>
            <column name="notes" value="Key partnership contact managing our referral program. Excellent relationship, regularly sends qualified startup leads. Quarterly business reviews are productive. Exploring co-marketing opportunities for 2025."/>
            <column name="created_by" value="owner"/>
            <column name="updated_by" value="manager"/>
        </insert>

        <!-- Activity 1: Follow-up Call with Sarah Chen (TechCorp) -->
        <!-- Scheduled follow-up call to discuss technical requirements and POC timeline -->
        <insert tableName="activities">
            <column name="contact_id" valueComputed="(SELECT id FROM contacts WHERE email = 'sarah.chen@techcorp-industries.com')"/>
            <column name="company_id" valueComputed="(SELECT id FROM companies WHERE name = 'TechCorp Industries')"/>
            <column name="type" value="CALL"/>
            <column name="subject" value="Technical Requirements Discussion - POC Planning"/>
            <column name="description" value="Follow-up call with Sarah Chen to discuss technical requirements for the proof of concept. Topics: API integration capabilities, data migration timeline, security compliance requirements, and POC success criteria. Prepare technical architecture overview and integration documentation."/>
            <column name="status" value="PENDING"/>
            <column name="priority" value="HIGH"/>
            <column name="due_date" valueDate="2025-01-25T14:00:00Z"/>
            <column name="completed_at" value=""/>
            <column name="created_by" value="admin"/>
            <column name="updated_by" value="admin"/>
            <column name="assigned_to" value="admin"/>
        </insert>

        <!-- Activity 2: Quarterly Business Review with Michael Rodriguez (Global Retail) -->
        <!-- Completed quarterly review meeting with existing customer -->
        <insert tableName="activities">
            <column name="contact_id" valueComputed="(SELECT id FROM contacts WHERE email = 'm.rodriguez@globalretail.com')"/>
            <column name="company_id" valueComputed="(SELECT id FROM companies WHERE name = 'Global Retail Solutions')"/>
            <column name="type" value="MEETING"/>
            <column name="subject" value="Q4 2024 Quarterly Business Review"/>
            <column name="description" value="Quarterly business review with Michael Rodriguez and his team. Covered: platform usage metrics (95% user adoption), ROI analysis ($2.3M in efficiency gains), upcoming feature requests, and expansion opportunities. Discussed potential rollout to European operations in Q2 2025."/>
            <column name="status" value="COMPLETED"/>
            <column name="priority" value="MEDIUM"/>
            <column name="due_date" valueDate="2024-12-20T10:00:00Z"/>
            <column name="completed_at" valueDate="2024-12-20T11:30:00Z"/>
            <column name="created_by" value="billing"/>
            <column name="updated_by" value="billing"/>
            <column name="assigned_to" value="billing"/>
        </insert>

        <!-- Activity 3: Partnership Strategy Meeting with Jennifer Park (StartupHub) -->
        <!-- Strategic planning meeting for 2025 partnership initiatives -->
        <insert tableName="activities">
            <column name="contact_id" valueComputed="(SELECT id FROM contacts WHERE email = 'jennifer.park@startuphub.io')"/>
            <column name="company_id" valueComputed="(SELECT id FROM companies WHERE name = 'StartupHub Accelerator')"/>
            <column name="type" value="MEETING"/>
            <column name="subject" value="2025 Partnership Strategy Planning"/>
            <column name="description" value="Strategic planning session with Jennifer Park to outline 2025 partnership initiatives. Agenda: referral program optimization, co-marketing campaign planning, joint webinar series, startup success metrics tracking, and expanded partner benefits program. Goal: 50% increase in qualified referrals."/>
            <column name="status" value="PENDING"/>
            <column name="priority" value="MEDIUM"/>
            <column name="due_date" valueDate="2025-01-30T15:00:00Z"/>
            <column name="completed_at" value=""/>
            <column name="created_by" value="manager"/>
            <column name="updated_by" value="manager"/>
            <column name="assigned_to" value="owner"/>
        </insert>

        <!-- Webhook Configuration for External CRM Integration -->
        <!-- Demo webhook for integrating with external systems -->
        <insert tableName="webhooks">
            <column name="name" value="External CRM Sync"/>
            <column name="url" value="https://external-crm.demo.com/webhooks/contact-events"/>
            <column name="secret" value="demo_webhook_secret_2024"/>
            <column name="events" value="contact.created,contact.updated,contact.deleted,contact.converted"/>
            <column name="active" valueBoolean="true"/>
            <column name="retry_count" value="3"/>
            <column name="timeout_seconds" value="30"/>
            <column name="description" value="Webhook integration for syncing contact events with external CRM system. Sends real-time notifications for contact lifecycle events to maintain data consistency across platforms."/>
            <column name="created_at" valueDate="2024-12-01T00:00:00Z"/>
            <column name="updated_at" valueDate="2024-12-15T10:30:00Z"/>
            <column name="created_by" value="admin"/>
            <column name="updated_by" value="admin"/>
            <column name="last_triggered_at" valueDate="2024-12-20T14:22:15Z"/>
            <column name="success_count" value="47"/>
            <column name="failure_count" value="2"/>
        </insert>

        <rollback>
            <!-- Remove webhook -->
            <delete tableName="webhooks">
                <where>name = 'External CRM Sync'</where>
            </delete>
            
            <!-- Remove activities -->
            <delete tableName="activities">
                <where>contact_id IN (
                    SELECT id FROM contacts WHERE email IN (
                        'sarah.chen@techcorp-industries.com',
                        'm.rodriguez@globalretail.com',
                        'jennifer.park@startuphub.io'
                    )
                )</where>
            </delete>
            
            <!-- Remove contacts -->
            <delete tableName="contacts">
                <where>email IN (
                    'sarah.chen@techcorp-industries.com',
                    'm.rodriguez@globalretail.com',
                    'jennifer.park@startuphub.io'
                )</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
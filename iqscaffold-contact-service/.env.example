# IQ Scaffold Contact Service Environment Variables Template
# Copy this file to .env.local, .env.staging, or .env.production and configure values

# =============================================================================
# Database Configuration (iqscaffold.database prefix)
# =============================================================================
IQSCAFFOLD_DATABASE_URL=jdbc:postgresql://localhost:5432/iqscaffold_contact_local
IQSCAFFOLD_DATABASE_USERNAME=iqscaffold_contact
IQSCAFFOLD_DATABASE_PASSWORD=iqscaffold_password

# =============================================================================
# Redis Cache Configuration (iqscaffold.cache.redis prefix)
# =============================================================================
IQSCAFFOLD_CACHE_REDIS_HOST=localhost
IQSCAFFOLD_CACHE_REDIS_PORT=6379
IQSCAFFOLD_CACHE_REDIS_PASSWORD=
IQSCAFFOLD_CACHE_REDIS_DATABASE=0

# =============================================================================
# Messaging Configuration (RabbitMQ)
# =============================================================================
IQSCAFFOLD_MESSAGING_RABBITMQ_HOST=localhost
IQSCAFFOLD_MESSAGING_RABBITMQ_PORT=5672
IQSCAFFOLD_MESSAGING_RABBITMQ_USERNAME=iqscaffold
IQSCAFFOLD_MESSAGING_RABBITMQ_PASSWORD=iqscaffold_password

# =============================================================================
# Contact & CRM Configuration
# =============================================================================
USER_SERVICE_URL=http://user-service:8080
CRM_ENABLE_LEAD_SCORING=true
CRM_ENABLE_ACTIVITY_TRACKING=true
CRM_ENABLE_EMAIL_INTEGRATION=true

# =============================================================================
# Observability Configuration (iqscaffold.observability prefix)
# =============================================================================
IQSCAFFOLD_OBSERVABILITY_TRACING_ENDPOINT=http://localhost:4317

# =============================================================================
# Spring Profile Configuration
# =============================================================================
SPRING_PROFILES_ACTIVE=local

# =============================================================================
# Environment-Specific Examples
# =============================================================================

# Local Development Environment
# SPRING_PROFILES_ACTIVE=local
# IQSCAFFOLD_DATABASE_URL=jdbc:postgresql://localhost:5432/iqscaffold_contact_local
# USER_SERVICE_URL=http://user-service:8080

# Staging Environment
# SPRING_PROFILES_ACTIVE=staging
# IQSCAFFOLD_DATABASE_URL=jdbc:postgresql://staging-db:5432/iqscaffold_contact_staging
# USER_SERVICE_URL=http://user-service:8080

# Production Environment
# SPRING_PROFILES_ACTIVE=production
# IQSCAFFOLD_DATABASE_URL=jdbc:postgresql://production-db:5432/iqscaffold_contact_production
# USER_SERVICE_URL=http://user-service:8080

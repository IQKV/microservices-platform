# Local Development Environment Variables for Gateway Service
SPRING_PROFILES_ACTIVE=local

# Redis Configuration
GRIPDAY_CACHE_REDIS_HOST=localhost
GRIPDAY_CACHE_REDIS_PORT=6379
GRIPDAY_CACHE_REDIS_PASSWORD=
GRIPDAY_CACHE_REDIS_DATABASE=0

# Gateway Routing Configuration
GRIPDAY_GATEWAY_ROUTING_AUTH_SERVICE_URI=http://localhost:8080

# Gateway Security Configuration
GRIPDAY_GATEWAY_SECURITY_JWT_SECRET=local-development-secret-key-not-for-production-use
GRIPDAY_GATEWAY_SECURITY_AUTH_SERVICE_URL=http://localhost:8080

# Gateway CORS Configuration
GRIPDAY_GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Observability Configuration
GRIPDAY_OBSERVABILITY_TRACING_ENDPOINT=http://localhost:4317

# Redis Configuration
REDIS_PASSWORD=
{
  "mappings": [
    {
      "id": "auth-health-check",
      "name": "Auth Service Health Check",
      "request": {
        "method": "GET",
        "urlPath": "/actuator/health"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "status": "UP",
          "components": {
            "db": {
              "status": "UP"
            },
            "redis": {
              "status": "UP"
            }
          }
        }
      }
    },
    {
      "id": "jwt-validation",
      "name": "JWT Token Validation",
      "request": {
        "method": "POST",
        "urlPath": "/api/v1/auth/validate",
        "headers": {
          "Authorization": {
            "matches": "Bearer .*"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "valid": true,
          "userContext": {
            "userId": 1,
            "username": "testuser",
            "email": "test@example.com",
            "roles": ["USER"],
            "tenantId": "default"
          }
        }
      }
    },
    {
      "id": "jwt-validation-invalid",
      "name": "JWT Token Validation - Invalid Token",
      "request": {
        "method": "POST",
        "urlPath": "/api/v1/auth/validate",
        "headers": {
          "Authorization": {
            "matches": "Bearer invalid.*"
          }
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "error": {
            "code": "AUTH_INVALID_TOKEN",
            "message": "Invalid or expired JWT token",
            "timestamp": "{{now format='yyyy-MM-dd HH:mm:ss'}}"
          }
        }
      }
    },
    {
      "id": "user-login",
      "name": "User Login",
      "request": {
        "method": "POST",
        "urlPath": "/api/v1/auth/login"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ0ZXN0dXNlciIsInVzZXJJZCI6MSwiZW1haWwiOiJ0ZXN0QGV4YW1wbGUuY29tIiwicm9sZXMiOlsiVVNFUiJdLCJ0ZW5hbnRJZCI6ImRlZmF1bHQiLCJpYXQiOjE2MzQ1Njc4OTAsImV4cCI6MTYzNDU2ODc5MH0.mock-signature",
          "refreshToken": "refresh-token-mock",
          "expiresIn": 900,
          "tokenType": "Bearer",
          "userContext": {
            "userId": 1,
            "username": "testuser",
            "email": "test@example.com",
            "roles": ["USER"],
            "tenantId": "default"
          }
        }
      }
    }
  ]
}

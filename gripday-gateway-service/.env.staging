# Staging Environment Variables for Gateway Service
SPRING_PROFILES_ACTIVE=staging

# Redis Configuration
GRIPDAY_CACHE_REDIS_HOST=redis
GRIPDAY_CACHE_REDIS_PORT=6379
GRIPDAY_CACHE_REDIS_PASSWORD=${REDIS_PASSWORD}
GRIPDAY_CACHE_REDIS_DATABASE=1

# Gateway Routing Configuration
GRIPDAY_GATEWAY_ROUTING_AUTH_SERVICE_URI=http://auth-service:8081

# Gateway Security Configuration
GRIPDAY_GATEWAY_SECURITY_JWT_SECRET=${JWT_SECRET}
GRIPDAY_GATEWAY_SECURITY_AUTH_SERVICE_URL=http://auth-service:8081

# Gateway CORS Configuration
GRIPDAY_GATEWAY_CORS_ALLOWED_ORIGINS=https://gripday.website

# Observability Configuration
GRIPDAY_OBSERVABILITY_TRACING_ENDPOINT=http://jaeger:14268/api/traces

# Redis Configuration
REDIS_PASSWORD=${REDIS_PASSWORD}
{
  "groups": [
    {
      "name": "gripday",
      "type": "org.gripday.gatewayservice.config.GripdayProperties",
      "description": "Configuration properties for Gripday Gateway Service"
    },
    {
      "name": "gripday.cache",
      "type": "org.gripday.gatewayservice.config.GripdayProperties$CacheProperties",
      "description": "Cache configuration with Redis support"
    },
    {
      "name": "gripday.gateway",
      "type": "org.gripday.gatewayservice.config.GripdayProperties$GatewayProperties",
      "description": "Gateway configuration for routing, security, rate limiting, circuit breaker, CORS, and transformation"
    },
    {
      "name": "gripday.gateway.routing",
      "type": "org.gripday.gatewayservice.config.GripdayProperties$GatewayProperties$RoutingProperties",
      "description": "Service routing with dynamic enable/disable support"
    },
    {
      "name": "gripday.gateway.routing.api-prefix",
      "type": "org.gripday.gatewayservice.config.GripdayProperties$GatewayProperties$RoutingProperties$ApiPrefixProperties",
      "description": "API prefix for environment-specific routing"
    },
    {
      "name": "gripday.gateway.routing.services",
      "type": "java.util.Map",
      "description": "Service configurations with dynamic enable/disable"
    },
    {
      "name": "gripday.gateway.security",
      "type": "org.gripday.gatewayservice.config.GripdayProperties$GatewayProperties$SecurityProperties",
      "description": "JWT authentication and security configuration"
    },
    {
      "name": "gripday.gateway.security.authentication",
      "type": "org.gripday.gatewayservice.config.GripdayProperties$GatewayProperties$SecurityProperties$AuthenticationProperties",
      "description": "Authentication service integration"
    },
    {
      "name": "gripday.gateway.transformation",
      "type": "org.gripday.gatewayservice.config.GripdayProperties$GatewayProperties$TransformationProperties",
      "description": "Request and response transformation"
    },
    {
      "name": "gripday.observability",
      "type": "org.gripday.gatewayservice.config.GripdayProperties$ObservabilityProperties",
      "description": "Observability for tracing, metrics, and logging"
    }
  ],
  "properties": [
    {
      "name": "gripday.gateway.routing.api-prefix.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable API prefix handling",
      "defaultValue": true
    },
    {
      "name": "gripday.gateway.routing.api-prefix.prefix",
      "type": "java.lang.String",
      "description": "API prefix (/api for dev/staging, empty for production)",
      "defaultValue": "/api"
    },
    {
      "name": "gripday.gateway.routing.api-prefix.strip-count",
      "type": "java.lang.Integer",
      "description": "Number of path segments to strip (0-5)",
      "defaultValue": 0
    },
    {
      "name": "gripday.gateway.routing.services.*.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable/disable service route dynamically",
      "defaultValue": true
    },
    {
      "name": "gripday.gateway.routing.services.*.uri",
      "type": "java.lang.String",
      "description": "Service base URI"
    },
    {
      "name": "gripday.gateway.routing.services.*.path",
      "type": "java.lang.String",
      "description": "Service path pattern"
    },
    {
      "name": "gripday.gateway.routing.services.*.connect-timeout",
      "type": "java.lang.Integer",
      "description": "Connection timeout in milliseconds",
      "defaultValue": 5000
    },
    {
      "name": "gripday.gateway.routing.services.*.response-timeout",
      "type": "java.lang.Integer",
      "description": "Response timeout in milliseconds",
      "defaultValue": 30000
    },
    {
      "name": "gripday.gateway.security.jwt.algorithm",
      "type": "java.lang.String",
      "description": "JWT algorithm (HS256 or RS256)",
      "defaultValue": "RS256"
    },
    {
      "name": "gripday.gateway.security.jwt.issuer",
      "type": "java.lang.String",
      "description": "JWT issuer (must match User Service issuer)",
      "defaultValue": "gripday-user-service"
    },
    {
      "name": "gripday.gateway.security.jwt.audience",
      "type": "java.lang.String",
      "description": "JWT audience (optional for RS256)"
    },
    {
      "name": "gripday.gateway.security.jwt.jwk-set-uri",
      "type": "java.lang.String",
      "description": "JWK Set URI for fetching public keys (required for RS256)",
      "defaultValue": "http://localhost:8080/.well-known/jwks.json"
    },
    {
      "name": "gripday.gateway.security.jwt.access-token-expiry",
      "type": "java.time.Duration",
      "description": "Access token expiration duration",
      "defaultValue": "PT15M"
    },
    {
      "name": "gripday.gateway.security.jwt.refresh-token-expiry",
      "type": "java.time.Duration",
      "description": "Refresh token expiration duration",
      "defaultValue": "P7D"
    },
    {
      "name": "gripday.gateway.security.authentication.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable authentication",
      "defaultValue": true
    },
    {
      "name": "gripday.gateway.security.authentication.user-service-url",
      "type": "java.lang.String",
      "description": "User service URL for authentication",
      "defaultValue": "http://localhost:8080"
    },
    {
      "name": "gripday.gateway.security.authentication.enable-user-context-propagation",
      "type": "java.lang.Boolean",
      "description": "Propagate user context headers to downstream services",
      "defaultValue": true
    },
    {
      "name": "gripday.gateway.transformation.request.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable request transformation",
      "defaultValue": true
    },
    {
      "name": "gripday.gateway.transformation.request.enable-header-enrichment",
      "type": "java.lang.Boolean",
      "description": "Enable header enrichment",
      "defaultValue": true
    },
    {
      "name": "gripday.gateway.transformation.request.enable-user-context-propagation",
      "type": "java.lang.Boolean",
      "description": "Enable user context propagation",
      "defaultValue": true
    },
    {
      "name": "gripday.gateway.transformation.request.enable-tenant-context-propagation",
      "type": "java.lang.Boolean",
      "description": "Enable tenant context propagation",
      "defaultValue": true
    },
    {
      "name": "gripday.gateway.rate-limiting.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable rate limiting",
      "defaultValue": true
    },
    {
      "name": "gripday.gateway.circuit-breaker.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable circuit breaker",
      "defaultValue": true
    },
    {
      "name": "gripday.gateway.cors.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable CORS",
      "defaultValue": true
    }
  ],
  "hints": [
    {
      "name": "gripday.gateway.routing.api-prefix.strip-count",
      "values": [
        {
          "value": 0,
          "description": "No stripping - forward full path"
        },
        {
          "value": 1,
          "description": "Strip one segment (e.g., /api)"
        },
        {
          "value": 2,
          "description": "Strip two segments"
        }
      ]
    },
    {
      "name": "gripday.gateway.routing.api-prefix.prefix",
      "values": [
        {
          "value": "/api",
          "description": "Standard API prefix"
        },
        {
          "value": "",
          "description": "No prefix (production)"
        },
        {
          "value": "/v1",
          "description": "Version-specific prefix"
        }
      ]
    },
    {
      "name": "gripday.gateway.security.jwt.algorithm",
      "values": [
        {
          "value": "RS256",
          "description": "RSA SHA-256 (asymmetric) - Recommended"
        },
        {
          "value": "HS256",
          "description": "HMAC SHA-256 (symmetric) - Deprecated"
        }
      ]
    },
    {
      "name": "gripday.gateway.security.jwt.jwk-set-uri",
      "values": [
        {
          "value": "http://localhost:8080/.well-known/jwks.json",
          "description": "Local User Service JWK endpoint"
        },
        {
          "value": "http://user-service:8080/.well-known/jwks.json",
          "description": "Docker/Kubernetes User Service JWK endpoint"
        },
        {
          "value": "https://api.gripday.com/.well-known/jwks.json",
          "description": "Production User Service JWK endpoint"
        }
      ]
    },
    {
      "name": "gripday.gateway.routing.services.*.enabled",
      "values": [
        {
          "value": true,
          "description": "Enable service route"
        },
        {
          "value": false,
          "description": "Disable service route (returns 404)"
        }
      ]
    },
    {
      "name": "gripday.gateway.security.authentication.enable-user-context-propagation",
      "values": [
        {
          "value": true,
          "description": "Propagate X-User-ID, X-Username, X-User-Roles headers"
        },
        {
          "value": false,
          "description": "Do not propagate user context headers"
        }
      ]
    }
  ]
}

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.gripday</groupId>
        <artifactId>gripday</artifactId>
        <version>0.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>gripday-gateway-service</artifactId>
    <packaging>jar</packaging>

    <name>Gripday Gateway Service</name>
    <description>API Gateway with routing, authentication, and rate limiting</description>

    <dependencies>
        <!-- Spring Cloud Gateway -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Circuit breaker -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <!-- OpenAPI documentation -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
        </dependency>

        <!-- Observability -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>

        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*Application.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.27</minimum>
                                        </limit>
                                        <limit>
                                            <counter>CLASS</counter>
                                            <value>MISSEDCOUNT</value>
                                            <maximum>49</maximum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <excludes>
                                        <exclude>org.gripday.gatewayservice.service.TenantQuotaMonitoringService</exclude>
                                        <exclude>org.gripday.gatewayservice.service.TenantQuotaMonitoringService.TenantUsageStats</exclude>
                                        <exclude>org.gripday.gatewayservice.security.JwtAuthenticationFilter</exclude>
                                        <exclude>org.gripday.gatewayservice.security.JwtAuthenticationFilter.UserContext</exclude>
                                        <exclude>org.gripday.gatewayservice.security.JwtAuthenticationFilter.TenantContext</exclude>
                                        <exclude>org.gripday.gatewayservice.presentation.web.ApiDocumentationResource</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.RateLimitingProperties.RedisProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.MetricsConfig</exclude>
                                        <exclude>org.gripday.gatewayservice.config.ServiceRegistryInitializer</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.SecurityProperties.JwtProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.RoutingProperties.ServiceProperties.OpenApiProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.RoutingProperties.ServiceProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.HealthCheckConfig.UserServiceHealthIndicator</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GatewayConfig</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.SecurityProperties.AuthenticationProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.RateLimitingProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.ObservabilityProperties.TracingProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.ObservabilityProperties.MetricsProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.RedisConfiguration</exclude>
                                        <exclude>org.gripday.gatewayservice.config.CircuitBreakerConfig</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.RoutingProperties.LoadBalancingProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.SecurityConfiguration</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.SecurityProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.ApiPrefixConfigurationLogger</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.RateLimitingProperties.PoliciesProperties.EndpointPolicyProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.RoutingProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.HealthCheckConfig</exclude>
                                        <exclude>org.gripday.gatewayservice.config.DynamicOpenApiRoutesConfiguration</exclude>
                                        <exclude>org.gripday.gatewayservice.config.OpenApiConfig</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.CircuitBreakerProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.RoutingProperties.ApiPrefixProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.filter.TenantRateLimitingFilter</exclude>
                                        <exclude>org.gripday.gatewayservice.filter.ResponseTransformationFilter</exclude>
                                        <exclude>org.gripday.gatewayservice.filter.TenantExtractionFilter</exclude>
                                        <exclude>org.gripday.gatewayservice.filter.LoadBalancingFilter</exclude>
                                        <exclude>org.gripday.gatewayservice.filter.CorrelationIdFilter</exclude>
                                        <exclude>org.gripday.gatewayservice.filter.TenantExtractionFilter.TenantContext</exclude>
                                        <exclude>org.gripday.gatewayservice.filter.LoadBalancingFilter.Config</exclude>
                                        <exclude>org.gripday.gatewayservice.filter.ResponseTransformationFilter.Config</exclude>
                                        <exclude>org.gripday.gatewayservice.filter.CircuitBreakerFilter</exclude>
                                        <exclude>org.gripday.gatewayservice.config.CorsConfiguration</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.CorsProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.ObservabilityProperties.LoggingProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.HealthCheckConfig.ReactiveRedisHealthIndicator</exclude>
                                        <exclude>org.gripday.gatewayservice.config.SpringDocConfiguration</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.RateLimitingProperties.PoliciesProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GripdayProperties.GatewayProperties.RateLimitingProperties.TenantQuotasProperties</exclude>
                                        <exclude>org.gripday.gatewayservice.config.ObservabilityConfig</exclude>
                                        <exclude>org.gripday.gatewayservice.config.GlobalExceptionHandler</exclude>
                                    </excludes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.01</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

# Production Environment Variables for Gateway Service
SPRING_PROFILES_ACTIVE=production

# Redis Configuration
GRIPDAY_CACHE_REDIS_HOST=${REDIS_HOST}
GRIPDAY_CACHE_REDIS_PORT=6379
GRIPDAY_CACHE_REDIS_PASSWORD=${REDIS_PASSWORD}
GRIPDAY_CACHE_REDIS_DATABASE=2

# Gateway Routing Configuration
GRIPDAY_GATEWAY_ROUTING_USER_SERVICE_URI=http://user-service:8080

# Gateway Security Configuration
GRIPDAY_GATEWAY_SECURITY_JWT_SECRET=${JWT_SECRET}
GRIPDAY_GATEWAY_SECURITY_USER_SERVICE_URL=http://user-service:8080

# Gateway CORS Configuration
GRIPDAY_GATEWAY_CORS_ALLOWED_ORIGINS=${ALLOWED_ORIGINS}

# Observability Configuration
GRIPDAY_OBSERVABILITY_TRACING_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT}

# Redis Configuration
REDIS_PASSWORD=${REDIS_PASSWORD}
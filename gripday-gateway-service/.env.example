# Gripday Gateway Service Environment Variables Template
# Copy this file to .env.local, .env.staging, or .env.production and configure values

# =============================================================================
# Redis Cache Configuration (gripday.cache.redis prefix)
# =============================================================================
GRIPDAY_CACHE_REDIS_HOST=localhost
GRIPDAY_CACHE_REDIS_PORT=6379
GRIPDAY_CACHE_REDIS_PASSWORD=
GRIPDAY_CACHE_REDIS_DATABASE=0

# =============================================================================
# Gateway Routing Configuration (gripday.gateway.routing prefix)
# =============================================================================
GRIPDAY_GATEWAY_ROUTING_USER_SERVICE_URI=http://localhost:8080

# API Prefix Configuration
# Local/Staging: Use /api prefix (e.g., http://localhost:8080/api/v1/auth/login)
# Production: Use empty prefix when deployed on api.gripday.com (e.g., https://api.gripday.com/v1/auth/login)
# GRIPDAY_GATEWAY_ROUTING_API_PREFIX_PREFIX=/api
# GRIPDAY_GATEWAY_ROUTING_API_PREFIX_STRIP_COUNT=0

# =============================================================================
# Gateway Security Configuration (gripday.gateway.security prefix)
# =============================================================================
GRIPDAY_GATEWAY_SECURITY_JWT_SECRET=your-jwt-secret-key-change-in-production
GRIPDAY_GATEWAY_SECURITY_USER_SERVICE_URL=http://localhost:8080

# =============================================================================
# Gateway CORS Configuration (gripday.gateway.cors prefix)
# =============================================================================
GRIPDAY_GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# Observability Configuration (gripday.observability prefix)
# =============================================================================
GRIPDAY_OBSERVABILITY_TRACING_ENDPOINT=http://localhost:4317

# =============================================================================
# Spring Profile Configuration
# =============================================================================
SPRING_PROFILES_ACTIVE=local

# =============================================================================
# Environment-Specific Examples
# =============================================================================

# Local Development Environment
# SPRING_PROFILES_ACTIVE=local
# GRIPDAY_GATEWAY_ROUTING_USER_SERVICE_URI=http://localhost:8080
# GRIPDAY_CACHE_REDIS_HOST=localhost
# GRIPDAY_GATEWAY_SECURITY_JWT_SECRET=local-development-secret-key-not-for-production-use
# GRIPDAY_GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Staging Environment
# SPRING_PROFILES_ACTIVE=staging
# GRIPDAY_GATEWAY_ROUTING_USER_SERVICE_URI=http://user-service:8080
# GRIPDAY_CACHE_REDIS_HOST=staging-redis
# GRIPDAY_GATEWAY_SECURITY_JWT_SECRET=${VAULT_JWT_SECRET}
# GRIPDAY_GATEWAY_CORS_ALLOWED_ORIGINS=https://gripday.website

# Production Environment (deployed on api.gripday.com)
# SPRING_PROFILES_ACTIVE=production
# GRIPDAY_GATEWAY_ROUTING_USER_SERVICE_URI=http://user-service:8080
# GRIPDAY_GATEWAY_ROUTING_API_PREFIX_PREFIX=
# GRIPDAY_GATEWAY_ROUTING_API_PREFIX_STRIP_COUNT=0
# GRIPDAY_CACHE_REDIS_HOST=prod-redis
# GRIPDAY_GATEWAY_SECURITY_JWT_SECRET=${VAULT_JWT_SECRET}
# GRIPDAY_GATEWAY_CORS_ALLOWED_ORIGINS=https://app.gripday.com
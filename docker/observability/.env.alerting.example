# Alertmanager Configuration
# Copy this file to .env and configure with your actual values

# =============================================================================
# SMTP Configuration (for email alerts)
# =============================================================================

# SMTP server host and port
# Examples:
#   Gmail: smtp.gmail.com:587
#   SendGrid: smtp.sendgrid.net:587
#   AWS SES: email-smtp.us-east-1.amazonaws.com:587
SMTP_HOST=smtp.gmail.com:587

# Sender email address
SMTP_FROM=alerts@iqscaffold.com

# SMTP authentication credentials
# For Gmail: Use App Password (not your regular password)
# For SendGrid: Use API key as password
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# =============================================================================
# Slack Integration (for Slack notifications)
# =============================================================================

# Slack Incoming Webhook URL
# Get this from: https://api.slack.com/messaging/webhooks
# Example: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=

# =============================================================================
# PagerDuty Integration (for critical alerts)
# =============================================================================

# PagerDuty Integration Key (Events API v2)
# Get this from: PagerDuty Service → Integrations → Events API v2
PAGERDUTY_SERVICE_KEY=

# =============================================================================
# Alert Recipients
# =============================================================================

# Critical alerts (service down, payment failures, etc.)
# Comma-separated list of email addresses
ALERT_EMAIL_CRITICAL=ops-critical@iqscaffold.com,oncall@iqscaffold.com

# Warning alerts (performance degradation, cache issues, etc.)
ALERT_EMAIL_WARNING=ops-warning@iqscaffold.com

# Payment-related alerts (payment failures, retry rates, etc.)
# Sent to both finance and ops teams
ALERT_EMAIL_PAYMENT=finance@iqscaffold.com,ops@iqscaffold.com

# Business metrics alerts (trial conversion, churn, revenue, etc.)
# Sent to product and ops teams
ALERT_EMAIL_BUSINESS=product@iqscaffold.com,ops@iqscaffold.com

# =============================================================================
# Grafana Configuration (optional)
# =============================================================================

# Grafana admin credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# =============================================================================
# Notes
# =============================================================================

# Gmail Setup:
# 1. Enable 2-factor authentication
# 2. Generate App Password: Google Account → Security → 2-Step Verification → App passwords
# 3. Use the generated password as SMTP_PASSWORD

# Slack Setup:
# 1. Create channels: #billing-alerts-critical and #billing-alerts-warning
# 2. Add Incoming Webhook integration
# 3. Copy webhook URL to SLACK_WEBHOOK_URL

# PagerDuty Setup:
# 1. Create a service for billing alerts
# 2. Add Events API v2 integration
# 3. Copy integration key to PAGERDUTY_SERVICE_KEY

# Testing:
# After configuration, test alerts with:
#   docker-compose -f docker-compose.observability.yml up -d
#   curl -X POST http://localhost:9093/api/v1/alerts -H "Content-Type: application/json" \
#     -d '[{"labels":{"alertname":"TestAlert","severity":"warning"},"annotations":{"summary":"Test"}}]'

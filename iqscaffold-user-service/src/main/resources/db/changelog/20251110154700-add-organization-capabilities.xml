<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="20251110154700-1" author="iqscaffold">
    <comment>Add Stripe capability fields to organizations table</comment>
    
    <addColumn schemaName="public" tableName="organizations">
      <column name="charges_enabled" type="boolean" defaultValueBoolean="false">
        <constraints nullable="true"/>
      </column>
    </addColumn>

    <addColumn schemaName="public" tableName="organizations">
      <column name="payouts_enabled" type="boolean" defaultValueBoolean="false">
        <constraints nullable="true"/>
      </column>
    </addColumn>

    <rollback>
      <dropColumn schemaName="public" tableName="organizations" columnName="charges_enabled"/>
      <dropColumn schemaName="public" tableName="organizations" columnName="payouts_enabled"/>
    </rollback>
  </changeSet>

</databaseChangeLog>

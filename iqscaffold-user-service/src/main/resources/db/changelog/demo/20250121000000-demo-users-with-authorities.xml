            </delete>
            
            <!-- Remove user authorities -->
            <delete tableName="user_authorities">
                <where>user_id IN (SELECT id FROM users WHERE tenant_id = 'demo-tenant')</where>
            </delete>
            
            <!-- Remove users -->
            <delete tableName="users">

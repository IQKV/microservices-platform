<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="20251210000000-1-rename-stripe-account-id" author="iqscaffold" context="public">
        <comment>Rename stripe_account_id to payment_gateway_account_id for multi-gateway support</comment>
        
        <renameColumn 
            schemaName="public"
            tableName="organizations"
            oldColumnName="stripe_account_id"
            newColumnName="payment_gateway_account_id"
            columnDataType="VARCHAR(255)"/>

        <rollback>
            <renameColumn 
                schemaName="public"
                tableName="organizations"
                oldColumnName="payment_gateway_account_id"
                newColumnName="stripe_account_id"
                columnDataType="VARCHAR(255)"/>
        </rollback>
    </changeSet>

    <changeSet id="20251210000000-2-add-payment-gateway-provider" author="iqscaffold" context="public">
        <comment>Add payment_gateway_provider column to support multiple payment gateways (STRIPE, PAYPAL, SQUARE, BRAINTREE)</comment>
        
        <addColumn schemaName="public" tableName="organizations">
            <column name="payment_gateway_provider" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn schemaName="public" tableName="organizations" columnName="payment_gateway_provider"/>
        </rollback>
    </changeSet>

    <changeSet id="20251210000000-3-migrate-existing-stripe-data" author="iqscaffold" context="public">
        <comment>Set existing payment gateway accounts to STRIPE provider</comment>
        
        <sql>
            UPDATE public.organizations 
            SET payment_gateway_provider = 'STRIPE'
            WHERE payment_gateway_account_id IS NOT NULL;
        </sql>

        <rollback>
            <sql>
                UPDATE public.organizations 
                SET payment_gateway_provider = NULL
                WHERE payment_gateway_provider = 'STRIPE';
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="20251210000000-4-drop-old-stripe-index" author="iqscaffold" context="public">
        <comment>Drop old stripe_account_id index</comment>
        
        <dropIndex 
            schemaName="public"
            tableName="organizations"
            indexName="idx_organizations_stripe_account"/>

        <rollback>
            <createIndex indexName="idx_organizations_stripe_account" tableName="organizations" schemaName="public">
                <column name="payment_gateway_account_id"/>
            </createIndex>
        </rollback>
    </changeSet>

    <changeSet id="20251210000000-5-create-gateway-indexes" author="iqscaffold" context="public">
        <comment>Create indexes for payment gateway account and provider lookups</comment>
        
        <createIndex indexName="idx_organizations_gateway_account" tableName="organizations" schemaName="public">
            <column name="payment_gateway_account_id"/>
            <column name="payment_gateway_provider"/>
        </createIndex>

        <createIndex indexName="idx_organizations_gateway_provider" tableName="organizations" schemaName="public">
            <column name="payment_gateway_provider"/>
        </createIndex>

        <rollback>
            <dropIndex schemaName="public" tableName="organizations" indexName="idx_organizations_gateway_account"/>
            <dropIndex schemaName="public" tableName="organizations" indexName="idx_organizations_gateway_provider"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

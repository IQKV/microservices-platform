# Local Development Environment Variables for User Service
SPRING_PROFILES_ACTIVE=local

# Database Configuration
IQSCAFFOLD_DATABASE_URL=jdbc:postgresql://localhost:5432/iqscaffold_user_local
IQSCAFFOLD_DATABASE_USERNAME=iqscaffold_user
IQSCAFFOLD_DATABASE_PASSWORD=iqscaffold_password

# Redis Configuration
IQSCAFFOLD_CACHE_REDIS_HOST=localhost
IQSCAFFOLD_CACHE_REDIS_PORT=6379
IQSCAFFOLD_CACHE_REDIS_PASSWORD=
IQSCAFFOLD_CACHE_REDIS_DATABASE=0

# Authentication Configuration
IQSCAFFOLD_AUTH_JWT_SECRET=local-development-secret-key-not-for-production-use
IQSCAFFOLD_AUTH_OAUTH2_GOOGLE_CLIENT_ID=
IQSCAFFOLD_AUTH_OAUTH2_GOOGLE_CLIENT_SECRET=
IQSCAFFOLD_AUTH_OAUTH2_GOOGLE_ENABLED=false

# Observability Configuration
IQSCAFFOLD_OBSERVABILITY_TRACING_ENDPOINT=http://localhost:4317

# PostgreSQL Database Configuration
POSTGRES_DB=iqscaffold_user_local
POSTGRES_USER=iqscaffold_user
POSTGRES_PASSWORD=iqscaffold_password

# Redis Configuration
REDIS_PASSWORD=
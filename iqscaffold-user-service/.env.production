# Production Environment Variables for User Service
SPRING_PROFILES_ACTIVE=production

# Database Configuration
IQSCAFFOLD_DATABASE_URL=jdbc:postgresql://${DB_HOST}:5432/iqscaffold_user_production
IQSCAFFOLD_DATABASE_USERNAME=${DB_USERNAME}
IQSCAFFOLD_DATABASE_PASSWORD=${DB_PASSWORD}

# Redis Configuration
IQSCAFFOLD_CACHE_REDIS_HOST=${REDIS_HOST}
IQSCAFFOLD_CACHE_REDIS_PORT=6379
IQSCAFFOLD_CACHE_REDIS_PASSWORD=${REDIS_PASSWORD}
IQSCAFFOLD_CACHE_REDIS_DATABASE=2

# Authentication Configuration
IQSCAFFOLD_AUTH_JWT_SECRET=${JWT_SECRET}
IQSCAFFOLD_AUTH_OAUTH2_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
IQSCAFFOLD_AUTH_OAUTH2_GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
IQSCAFFOLD_AUTH_OAUTH2_GOOGLE_ENABLED=${GOOGLE_OAUTH_ENABLED}

# Observability Configuration
IQSCAFFOLD_OBSERVABILITY_TRACING_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT}

# PostgreSQL Database Configuration
POSTGRES_DB=iqscaffold_user_production
POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}

# Redis Configuration
REDIS_PASSWORD=${REDIS_PASSWORD}
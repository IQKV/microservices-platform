# Local Development Environment Variables for User Service
SPRING_PROFILES_ACTIVE=local

# Database Configuration
GRIPDAY_DATABASE_URL=jdbc:postgresql://localhost:5432/gripday_user_local
GRIPDAY_DATABASE_USERNAME=gripday_user
GRIPDAY_DATABASE_PASSWORD=gripday_password

# Redis Configuration
GRIPDAY_CACHE_REDIS_HOST=localhost
GRIPDAY_CACHE_REDIS_PORT=6379
GRIPDAY_CACHE_REDIS_PASSWORD=
GRIPDAY_CACHE_REDIS_DATABASE=0

# Authentication Configuration
GRIPDAY_AUTH_JWT_SECRET=local-development-secret-key-not-for-production-use
GRIPDAY_AUTH_OAUTH2_GOOGLE_CLIENT_ID=
GRIPDAY_AUTH_OAUTH2_GOOGLE_CLIENT_SECRET=
GRIPDAY_AUTH_OAUTH2_GOOGLE_ENABLED=false

# Observability Configuration
GRIPDAY_OBSERVABILITY_TRACING_ENDPOINT=http://localhost:4317

# PostgreSQL Database Configuration
POSTGRES_DB=gripday_user_local
POSTGRES_USER=gripday_user
POSTGRES_PASSWORD=gripday_password

# Redis Configuration
REDIS_PASSWORD=
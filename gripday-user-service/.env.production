# Production Environment Variables for User Service
SPRING_PROFILES_ACTIVE=production

# Database Configuration
GRIPDAY_DATABASE_URL=jdbc:postgresql://${DB_HOST}:5432/gripday_user_production
GRIPDAY_DATABASE_USERNAME=${DB_USERNAME}
GRIPDAY_DATABASE_PASSWORD=${DB_PASSWORD}

# Redis Configuration
GRIPDAY_CACHE_REDIS_HOST=${REDIS_HOST}
GRIPDAY_CACHE_REDIS_PORT=6379
GRIPDAY_CACHE_REDIS_PASSWORD=${REDIS_PASSWORD}
GRIPDAY_CACHE_REDIS_DATABASE=2

# Authentication Configuration
GRIPDAY_AUTH_JWT_SECRET=${JWT_SECRET}
GRIPDAY_AUTH_OAUTH2_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GRIPDAY_AUTH_OAUTH2_GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
GRIPDAY_AUTH_OAUTH2_GOOGLE_ENABLED=${GOOGLE_OAUTH_ENABLED}

# Observability Configuration
GRIPDAY_OBSERVABILITY_TRACING_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT}

# PostgreSQL Database Configuration
POSTGRES_DB=gripday_user_production
POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}

# Redis Configuration
REDIS_PASSWORD=${REDIS_PASSWORD}
<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="00000000000001-1" author="system">
        <comment>Drop subdomain index from tenants table</comment>
        <dropIndex indexName="idx_tenants_subdomain" tableName="tenants"/>
    </changeSet>

    <changeSet id="00000000000001-2" author="system">
        <comment>Remove subdomain column from tenants table as subdomain-based tenancy is no longer supported</comment>
        <dropColumn tableName="tenants" columnName="subdomain"/>
    </changeSet>

</databaseChangeLog>

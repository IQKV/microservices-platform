<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="005-performance-optimization-indexes" author="gripday">
        <comment>Add performance indexes for frequently queried columns</comment>

        <!-- Index on users.username for authentication queries -->
        <createIndex indexName="idx_users_username" tableName="users">
            <column name="username"/>
        </createIndex>

        <!-- Index on users.email for authentication queries -->
        <createIndex indexName="idx_users_email" tableName="users">
            <column name="email"/>
        </createIndex>

        <!-- Index on users.tenant_id for multi-tenant queries -->
        <createIndex indexName="idx_users_tenant_id" tableName="users">
            <column name="tenant_id"/>
        </createIndex>

        <!-- Index on users.created_at for sorting and filtering -->
        <createIndex indexName="idx_users_created_at" tableName="users">
            <column name="created_at"/>
        </createIndex>

        <!-- Composite index on users.tenant_id and enabled for efficient tenant user queries -->
        <createIndex indexName="idx_users_tenant_enabled" tableName="users">
            <column name="tenant_id"/>
            <column name="enabled"/>
        </createIndex>

        <!-- Index on authorities.name for role lookups -->
        <createIndex indexName="idx_authorities_name" tableName="authorities">
            <column name="name"/>
        </createIndex>

        <!-- Index on user_audit_log.user_id for audit queries -->
        <createIndex indexName="idx_user_audit_log_user_id" tableName="user_audit_log">
            <column name="user_id"/>
        </createIndex>

        <!-- Index on user_audit_log.tenant_id for multi-tenant audit queries -->
        <createIndex indexName="idx_user_audit_log_tenant_id" tableName="user_audit_log">
            <column name="tenant_id"/>
        </createIndex>

        <!-- Index on user_audit_log.created_at for time-based audit queries -->
        <createIndex indexName="idx_user_audit_log_created_at" tableName="user_audit_log">
            <column name="created_at"/>
        </createIndex>

        <!-- Composite index on user_audit_log for efficient tenant-based audit queries -->
        <createIndex indexName="idx_user_audit_log_tenant_action" tableName="user_audit_log">
            <column name="tenant_id"/>
            <column name="action"/>
            <column name="created_at"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_users_username" tableName="users"/>
            <dropIndex indexName="idx_users_email" tableName="users"/>
            <dropIndex indexName="idx_users_tenant_id" tableName="users"/>
            <dropIndex indexName="idx_users_created_at" tableName="users"/>
            <dropIndex indexName="idx_users_tenant_enabled" tableName="users"/>
            <dropIndex indexName="idx_authorities_name" tableName="authorities"/>
            <dropIndex indexName="idx_user_audit_log_user_id" tableName="user_audit_log"/>
            <dropIndex indexName="idx_user_audit_log_tenant_id" tableName="user_audit_log"/>
            <dropIndex indexName="idx_user_audit_log_created_at" tableName="user_audit_log"/>
            <dropIndex indexName="idx_user_audit_log_tenant_action" tableName="user_audit_log"/>
        </rollback>
    </changeSet>
</databaseChangeLog>